{
  "name": "syncologic-marketing-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:local:stop": "bash scripts/dev-local-stop.sh",
    "db:reset": "npx --yes supabase db reset",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,json}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.6",
    "@lucide/astro": "^1.14.0",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.2.1",
    "resend": "^4.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^4.2.4",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
