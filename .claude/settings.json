{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm i)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npm outdated)",
      "Bash(npm ls:*)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx astro:*)",
      "Bash(npx vitest:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(node -e:*)",
      "Bash(node --version)",

      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list)",

      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(curl -i:*)",
      "Bash(curl -X:*)",
      "Bash(curl -s:*)",

      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:resend.com)",
      "WebFetch(domain:upstash.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:zod.dev)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit --no-gpg-sign:*)",
      "Bash(git commit -n:*)",
      "Bash(git config:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",

      "Bash(npx vercel deploy:*)",
      "Bash(npx vercel --prod:*)",
      "Bash(npx vercel env rm:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)"
    ],
    "ask": [
      "Bash(npm publish:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(npx vercel:*)",
      "Bash(supabase:*)"
    ]
  },
  "env": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  }
}
