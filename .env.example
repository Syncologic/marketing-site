# Local development — quick start
# ────────────────────────────────────────────────────────────────────
# 1. `cp .env.example .env` (no edits needed for local dev)
# 2. `npm run db:start` — boots local Supabase (Docker)
# 3. `npm run dev`      — Astro at http://localhost:4321
#
# Supabase runs for real (Docker). KV rate-limiting uses an
# in-memory store (resets on restart). Resend is faked — sent
# emails are written to `.local/dev-emails/*.html`. Production
# builds throw on missing values.

# Public — exposed to the browser
# REQUIRED. Used to build email links and as the canonical site origin.
# Setting it explicitly (instead of falling back to request.url's host)
# is what blocks host-header injection in welcome-email links.
# Local dev: http://localhost:4321 — production: https://syncologic.com
PUBLIC_SITE_URL=http://localhost:4321

# Supabase — server-only
# Local values below match `npx supabase start` output. The local
# JWT is deterministic across machines (signed with the CLI's standard
# local-dev secret). If it ever stops working after a CLI upgrade,
# run `npm run db:env` and refresh.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Resend — server-only (blank in dev = emails written to .local/dev-emails/)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Syncologic <hi@syncologic.com>

# HMAC secret for waitlist PATCH auth — server-only
# Blank in dev = stable dev-only fallback. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAITLIST_TOKEN_SECRET=

# Vercel KV / Upstash — server-only
# Blank in dev = in-memory rate-limit store (resets on restart).
# Required in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
