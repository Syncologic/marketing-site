# Public — exposed to the browser
# REQUIRED. Used to build email links and as the canonical site origin.
# Setting it explicitly (instead of falling back to request.url's host)
# is what blocks host-header injection in welcome-email links.
# Local dev: http://localhost:4321 — production: https://syncologic.com
PUBLIC_SITE_URL=http://localhost:4321

# Supabase — server-only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — server-only
RESEND_API_KEY=
RESEND_FROM_EMAIL=Syncologic <hi@syncologic.com>

# HMAC secret for waitlist PATCH auth — server-only
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAITLIST_TOKEN_SECRET=

# Vercel KV — server-only
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
