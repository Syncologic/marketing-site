---
import Layout from '../components/layout/Layout.astro';
import JsonLd from '../components/layout/JsonLd.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Section from '../components/ui/Section.astro';
import HorizonHero from '../components/homepage/HorizonHero.astro';
import ProviderRow from '../components/sections/ProviderRow.astro';
import SkyBackdrop from '../components/visuals/SkyBackdrop.astro';
import RunnerCards from '../components/sections/RunnerCards.astro';
import TrustStory from '../components/sections/TrustStory.astro';
import PlansSection from '../components/sections/PlansSection.astro';
import WaitlistForm from '../components/sections/WaitlistForm.astro';
import BottomCTA from '../components/sections/BottomCTA.astro';
import FAQ from '../components/sections/FAQ.astro';
import BackToTop from '../components/guides/BackToTop.astro';
import { getLocaleFromUrl, getT } from '../i18n/utils';
import en from '../i18n/en.json';
import ptBr from '../i18n/pt-br.json';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
const dict = locale === 'pt-br' ? ptBr : en;
const pricingFaq = dict.pricing.faq;
const title = `${t('site.name')} — ${t('site.tagline')}`;
const description = t('site.description');
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://syncologic.com';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Syncologic',
  url: siteUrl,
  logo: `${siteUrl}/assets/brand/icon_white_background.svg`,
  sameAs: [],
};
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: siteUrl,
  name: 'Syncologic',
  inLanguage: ['en', 'pt-BR'],
};
---

<Layout title={title} description={description}>
  <JsonLd slot="head" schema={[orgSchema, siteSchema]} />
  <Nav slot="nav" />
  <SkyBackdrop />

  <HorizonHero />

  <Section surface="sky" padding="md" id="supported-providers" reveal>
    <div class="text-center mb-8 max-w-2xl mx-auto">
      <h2 class="text-h1 font-display font-bold text-ink mb-3">{t('homepage.supportedProvidersTitle')}</h2>
      <p class="text-body text-ink mx-auto max-w-[60ch]">
        {t('homepage.supportedProvidersSubtitle')}
      </p>
    </div>
    <ProviderRow />
    <p class="text-caption text-ink-soft text-center mx-auto max-w-[60ch] mt-2 italic">
      {t('homepage.supportedProvidersNote')}
    </p>
  </Section>

  <Section surface="sky" padding="lg" id="how-it-works" reveal>
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-display-2 font-display font-bold text-ink mb-4 leading-[1.1] tracking-tight">
        {t('homepage.runnersTitle')}
      </h2>
    </div>
    <RunnerCards />
  </Section>

  <Section surface="sky" padding="lg" id="plans" reveal>
    <PlansSection />
  </Section>

  <Section surface="sky" padding="lg" reveal>
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-h1 font-display font-bold text-ink mb-3">{t('homepage.trustTitle')}</h2>
      <p class="text-body text-ink mx-auto max-w-[60ch]">
        {t('homepage.trustSubtitle')}
      </p>
    </div>
    <div class="mx-auto" style="max-width: 1200px;">
      <TrustStory />
    </div>
  </Section>

  <Section surface="sky" padding="lg" reveal>
    <BottomCTA />
  </Section>

  <WaitlistForm />

  <FAQ surface="tint" title={pricingFaq.title} items={pricingFaq.items} id="faq" />

  <BackToTop triggerSelector="#faq" />

  <Footer slot="footer" />

  <script>
    import { loadWaitlistState } from '../lib/waitlist-storage';

    const openGate = () => {
      document.querySelectorAll<HTMLElement>('[data-gate="joined"]').forEach((el) => {
        if (el.hasAttribute('hidden')) {
          el.removeAttribute('hidden');
          el.dataset.gateState = 'open';
        }
      });
    };

    if (loadWaitlistState()) openGate();
    window.addEventListener('waitlist:closed', openGate);
  </script>
</Layout>
