---
import Layout from '../components/layout/Layout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import { getT, localizedPath } from '../i18n/utils';

const en = getT('en');
const pt = getT('pt-br');
const title = `${en('notFound.title')} — ${en('site.name')}`;
const description = en('notFound.body');

const ptDict = {
  documentTitle: `${pt('notFound.title')} — ${pt('site.name')}`,
  eyebrow: pt('notFound.eyebrow'),
  title: pt('notFound.title'),
  body: pt('notFound.body'),
  ctaHome: pt('notFound.ctaHome'),
  hrefHome: localizedPath('pt-br', '/'),
};
---

<Layout title={title} description={description}>
  <Nav slot="nav" />

  <Section surface="sky" padding="lg">
    <div class="max-w-2xl mx-auto text-center">
      <span
        id="nf-eyebrow"
        class="text-caption font-medium uppercase tracking-wide text-ink-soft mb-5 block"
      >
        {en('notFound.eyebrow')}
      </span>
      <h1
        id="nf-title"
        class="text-display-2 lg:text-display-1 font-display font-bold text-ink mb-5 tracking-tight"
      >
        {en('notFound.title')}
      </h1>
      <p id="nf-body" class="text-body text-ink mb-8 max-w-lg mx-auto">
        {en('notFound.body')}
      </p>
      <div class="flex justify-center">
        <Button href={localizedPath('en', '/')} variant="primary" size="lg" class="nf-cta-home">
          {en('notFound.ctaHome')}
        </Button>
      </div>
    </div>
  </Section>

  <Footer slot="footer" />
</Layout>

<script define:vars={{ pt: ptDict }}>
  if (location.pathname.startsWith('/pt-br/') || location.pathname === '/pt-br') {
    document.documentElement.lang = 'pt-BR';
    document.title = pt.documentTitle;
    document.getElementById('nf-eyebrow').textContent = pt.eyebrow;
    document.getElementById('nf-title').textContent = pt.title;
    document.getElementById('nf-body').textContent = pt.body;
    const home = document.querySelector('.nf-cta-home');
    if (home) {
      home.textContent = pt.ctaHome;
      home.setAttribute('href', pt.hrefHome);
    }
  }
</script>
