---
import { getLocaleFromUrl, getT } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
const altLabel = t('visuals.hostedVsPrivatePath.alt');
const hostedLabel = t('visuals.hostedVsPrivatePath.hostedLabel');
const privateLabel = t('visuals.hostedVsPrivatePath.privateLabel');
---

<div class="hosted-vs-private w-full max-w-[480px] mx-auto" role="presentation">
  <svg
    viewBox="0 0 480 310"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={altLabel}
    class="w-full h-auto block"
  >
    <g aria-hidden="true">
      <rect x="20" y="40" width="80" height="60" rx="14" class="fill-[var(--glass-bg)]" />
      <path
        d="M 36 78 a 10 10 0 0 1 10 -10 a 14 14 0 0 1 26 4 a 8 8 0 0 1 0 16 H 42 a 8 8 0 0 1 -6 -10 z"
        class="fill-white stroke-[var(--ink-soft)]"
        stroke-width="1.2"
      />
    </g>

    <g aria-hidden="true">
      <rect x="170" y="45" width="140" height="50" rx="12" class="fill-[var(--glass-bg-strong)] stroke-[var(--ink-soft)]" stroke-width="1" />
      <g transform="translate(186 60)" class="stroke-[var(--ink-soft)]" stroke-width="1.2" stroke-linecap="round" fill="none">
        <rect x="0" y="0" width="20" height="9" rx="2" />
        <rect x="0" y="13" width="20" height="9" rx="2" />
        <circle cx="4" cy="4.5" r="1" class="fill-[var(--ink-soft)] stroke-none" />
        <circle cx="4" cy="17.5" r="1" class="fill-[var(--ink-soft)] stroke-none" />
        <line x1="9" y1="4.5" x2="16" y2="4.5" />
        <line x1="9" y1="17.5" x2="16" y2="17.5" />
      </g>
      <text x="216" y="74" class="box-label fill-[var(--ink)]">{hostedLabel}</text>
    </g>

    <g aria-hidden="true">
      <rect x="380" y="40" width="80" height="60" rx="14" class="fill-[var(--glass-bg)]" />
      <path
        d="M 396 78 a 10 10 0 0 1 10 -10 a 14 14 0 0 1 26 4 a 8 8 0 0 1 0 16 H 402 a 8 8 0 0 1 -6 -10 z"
        class="fill-white stroke-[var(--ink-soft)]"
        stroke-width="1.2"
      />
    </g>

    <path
      d="M 100 70 L 170 70"
      fill="none"
      stroke-width="1.5"
      stroke-dasharray="2 6"
      stroke-linecap="round"
      class="stroke-[var(--sky-action)]"
      aria-hidden="true"
    />
    <path
      d="M 310 70 L 380 70"
      fill="none"
      stroke-width="1.5"
      stroke-dasharray="2 6"
      stroke-linecap="round"
      class="stroke-[var(--sky-action)]"
      aria-hidden="true"
    />

    <g class="hosted-pills" aria-hidden="true">
      <g class="hosted-pill hosted-pill-a">
        <rect x="-22" y="-10" width="44" height="20" rx="10" class="fill-white stroke-[var(--sky-action)]" stroke-width="1" />
        <line x1="-12" y1="-3" x2="10" y2="-3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
        <line x1="-12" y1="3" x2="4" y2="3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
      </g>
      <g class="hosted-pill hosted-pill-b">
        <rect x="-22" y="-10" width="44" height="20" rx="10" class="fill-white stroke-[var(--sky-action)]" stroke-width="1" />
        <line x1="-12" y1="-3" x2="10" y2="-3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
        <line x1="-12" y1="3" x2="4" y2="3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
      </g>
    </g>

    <line
      x1="40" y1="155" x2="440" y2="155"
      class="stroke-[color:color-mix(in_srgb,var(--ink)_18%,transparent)]"
      stroke-width="1"
      stroke-dasharray="4 6"
      aria-hidden="true"
    />

    <g aria-hidden="true">
      <rect x="20" y="200" width="80" height="60" rx="14" class="fill-[var(--glass-bg)]" />
      <path
        d="M 36 238 a 10 10 0 0 1 10 -10 a 14 14 0 0 1 26 4 a 8 8 0 0 1 0 16 H 42 a 8 8 0 0 1 -6 -10 z"
        class="fill-white stroke-[var(--ink-soft)]"
        stroke-width="1.2"
      />
    </g>

    <g aria-hidden="true">
      <rect x="170" y="205" width="140" height="50" rx="12" class="fill-white stroke-[var(--ink-soft)]" stroke-width="1" />
      <g transform="translate(186 220)" class="stroke-[var(--ink-soft)]" stroke-width="1.2" stroke-linecap="round" fill="none">
        <rect x="0" y="0" width="20" height="9" rx="2" />
        <rect x="0" y="13" width="20" height="9" rx="2" />
        <circle cx="4" cy="4.5" r="1" class="fill-[var(--ink-soft)] stroke-none" />
        <circle cx="4" cy="17.5" r="1" class="fill-[var(--ink-soft)] stroke-none" />
        <line x1="9" y1="4.5" x2="16" y2="4.5" />
        <line x1="9" y1="17.5" x2="16" y2="17.5" />
      </g>
      <text x="216" y="234" class="box-label fill-[var(--ink)]">{privateLabel}</text>
    </g>

    <g aria-hidden="true">
      <rect x="380" y="200" width="80" height="60" rx="14" class="fill-[var(--glass-bg)]" />
      <path
        d="M 396 238 a 10 10 0 0 1 10 -10 a 14 14 0 0 1 26 4 a 8 8 0 0 1 0 16 H 402 a 8 8 0 0 1 -6 -10 z"
        class="fill-white stroke-[var(--ink-soft)]"
        stroke-width="1.2"
      />
    </g>

    <path
      d="M 100 230 L 170 230"
      fill="none"
      stroke-width="1.5"
      stroke-dasharray="2 6"
      stroke-linecap="round"
      class="stroke-[var(--sky-action)]"
      aria-hidden="true"
    />
    <path
      d="M 310 230 L 380 230"
      fill="none"
      stroke-width="1.5"
      stroke-dasharray="2 6"
      stroke-linecap="round"
      class="stroke-[var(--sky-action)]"
      aria-hidden="true"
    />

    <g class="private-pills" aria-hidden="true">
      <g class="private-pill private-pill-a">
        <rect x="-22" y="-10" width="44" height="20" rx="10" class="fill-white stroke-[var(--sky-action)]" stroke-width="1" />
        <line x1="-12" y1="-3" x2="10" y2="-3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
        <line x1="-12" y1="3" x2="4" y2="3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
      </g>
      <g class="private-pill private-pill-b">
        <rect x="-22" y="-10" width="44" height="20" rx="10" class="fill-white stroke-[var(--sky-action)]" stroke-width="1" />
        <line x1="-12" y1="-3" x2="10" y2="-3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
        <line x1="-12" y1="3" x2="4" y2="3" stroke-width="1.5" stroke-linecap="round" class="stroke-[var(--sky-action)]" />
      </g>
    </g>
  </svg>
</div>

<style>
  .hosted-vs-private { min-width: 280px; }

  .box-label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .hosted-pill,
  .private-pill {
    offset-rotate: 0deg;
    offset-distance: 0%;
    opacity: 0;
  }
  .hosted-pill {
    offset-path: path('M 100 70 L 380 70');
  }
  .private-pill {
    offset-path: path('M 100 230 L 380 230');
  }

  @media (prefers-reduced-motion: no-preference) {
    .hosted-pill-a  { animation: hvp-pill-travel 4s linear infinite; }
    .hosted-pill-b  { animation: hvp-pill-travel 4s linear infinite 2s; }
    .private-pill-a { animation: hvp-pill-travel 4s linear infinite 1s; }
    .private-pill-b { animation: hvp-pill-travel 4s linear infinite 3s; }

    @keyframes hvp-pill-travel {
      0%   { offset-distance: 0%;   opacity: 0; }
      8%   { offset-distance: 4%;   opacity: 1; }
      92%  { offset-distance: 96%;  opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hosted-pill-a  { offset-distance: 35%; opacity: 1; }
    .hosted-pill-b  { offset-distance: 65%; opacity: 1; }
    .private-pill-a { offset-distance: 35%; opacity: 1; }
    .private-pill-b { offset-distance: 65%; opacity: 1; }
  }
</style>
