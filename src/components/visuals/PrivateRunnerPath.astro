---
import ProviderLogo from '../ui/ProviderLogo.astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
const altLabel = t('visuals.privateRunnerPath.alt');
const boundaryLabel = t('visuals.privateRunnerPath.boundary');
const sourceLabel = t('visuals.privateRunnerPath.source');
const machineLabel = t('visuals.privateRunnerPath.machine');
const destinationLabel = t('visuals.privateRunnerPath.destination');
---

<div class="prp-stage" role="img" aria-label={altLabel}>
  <svg class="prp-stage__sky" viewBox="0 0 400 400" aria-hidden="true">
    <defs>
      <radialGradient id="prp-bloom" cx="50%" cy="50%" r="55%">
        <stop offset="0%"  stop-color="var(--sky-action)" stop-opacity="0.20" />
        <stop offset="55%" stop-color="var(--sky-action)" stop-opacity="0.05" />
        <stop offset="100%" stop-color="var(--sky-action)" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="prp-flow" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"   stop-color="var(--sky-action)" stop-opacity="0.20" />
        <stop offset="50%"  stop-color="var(--sky-action)" stop-opacity="0.70" />
        <stop offset="100%" stop-color="var(--sky-action)" stop-opacity="0.20" />
      </linearGradient>
    </defs>

    <circle cx="200" cy="200" r="180" fill="url(#prp-bloom)" />

    <!-- YOUR NETWORK perimeter wrapping the runner -->
    <rect class="prp-stage__perimeter"
      x="128" y="80" width="144" height="240" rx="28"
      fill="color-mix(in srgb, var(--sky-action) 6%, transparent)"
      stroke="color-mix(in srgb, var(--sky-action) 55%, transparent)"
      stroke-width="1.4" stroke-dasharray="5 7" />

    <!-- Flow line source → runner → destination, crossing the perimeter -->
    <path class="prp-stage__flow"
      d="M 56 200 L 344 200"
      fill="none" stroke="url(#prp-flow)" stroke-width="1.8"
      stroke-dasharray="4 7" stroke-linecap="round" />

    <!-- Pulse rings around the runner -->
    <g class="prp-stage__pulse" aria-hidden="true">
      <rect x="168" y="160" width="64" height="80" rx="18" fill="none"
        stroke="var(--sky-action)" stroke-opacity="0.18" />
      <rect x="152" y="144" width="96" height="112" rx="24" fill="none"
        stroke="var(--sky-action)" stroke-opacity="0.10" />
    </g>

    <g class="prp-stage__packets" aria-hidden="true">
      <rect class="prp-stage__packet prp-stage__packet--in"  x="-9" y="-5" width="18" height="10" rx="2.5" />
      <rect class="prp-stage__packet prp-stage__packet--out" x="-9" y="-5" width="18" height="10" rx="2.5" />
    </g>
  </svg>

  <span class="prp-stage__boundary-badge">{boundaryLabel}</span>

  <div class="prp-stage__node prp-stage__node--source">
    <div class="prp-stage__node-inner glass-pane" data-squircle data-squircle-radius="20">
      <ProviderLogo provider="google-drive" size={44} />
    </div>
    <span class="prp-stage__node-label">{sourceLabel}</span>
  </div>

  <div class="prp-stage__rack glass-pane" data-squircle data-squircle-radius="22">
    <span class="prp-stage__slot">
      <span class="prp-stage__led prp-stage__led--1"></span>
      <span class="prp-stage__led prp-stage__led--2"></span>
      <span class="prp-stage__bar"></span>
    </span>
    <span class="prp-stage__slot">
      <span class="prp-stage__led prp-stage__led--3"></span>
      <span class="prp-stage__led prp-stage__led--4"></span>
      <span class="prp-stage__bar"></span>
    </span>
    <span class="prp-stage__slot">
      <span class="prp-stage__led prp-stage__led--5"></span>
      <span class="prp-stage__led prp-stage__led--6"></span>
      <span class="prp-stage__bar"></span>
    </span>
    <span class="prp-stage__rack-label">{machineLabel}</span>
  </div>

  <span class="prp-stage__lock" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="16" height="16">
      <path d="M 8 11 V 8 a 4 4 0 0 1 8 0 V 11"
        fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
      <rect x="5.5" y="11" width="13" height="9" rx="2" fill="#ffffff" />
      <circle cx="12" cy="14.6" r="1.3" fill="var(--sky-action)" />
      <rect x="11.35" y="14.6" width="1.3" height="3" rx="0.4" fill="var(--sky-action)" />
    </svg>
  </span>

  <div class="prp-stage__node prp-stage__node--dest">
    <div class="prp-stage__node-inner glass-pane" data-squircle data-squircle-radius="20">
      <ProviderLogo provider="s3" size={44} />
    </div>
    <span class="prp-stage__node-label">{destinationLabel}</span>
  </div>
</div>

<style>
  .prp-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    isolation: isolate;
    display: block;
  }
  .prp-stage__sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .prp-stage__boundary-badge {
    position: absolute;
    top: 16%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--sky-action);
    color: #ffffff;
    white-space: nowrap;
    z-index: 3;
    line-height: 1;
  }

  .prp-stage__node {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 2;
  }
  .prp-stage__node--source { left: 4%; }
  .prp-stage__node--dest   { right: 4%; }
  .prp-stage__node-inner {
    width: 76px;
    height: 76px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .prp-stage__node-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .prp-stage__rack {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 26%;
    aspect-ratio: 1 / 1.15;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 14px 26px;
    z-index: 2;
  }
  .prp-stage__slot {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .prp-stage__led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sky-action);
    box-shadow: 0 0 4px color-mix(in srgb, var(--sky-action) 60%, transparent);
  }
  .prp-stage__bar {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sky-action) 22%, transparent);
  }
  .prp-stage__rack-label {
    position: absolute;
    bottom: 7px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--sky-action);
    text-transform: uppercase;
  }

  .prp-stage__lock {
    position: absolute;
    top: calc(50% - 15px);
    left: calc(50% + 32px);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, color-mix(in srgb, #ffffff 20%, var(--sky-action)), var(--sky-action));
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--glass-bg-strong) 90%, transparent),
      0 6px 14px -4px color-mix(in srgb, var(--sky-action) 60%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.28);
    transform: translate(60%, -160%);
    z-index: 3;
  }

  .prp-stage__packet {
    fill: var(--sky-action);
    opacity: 0;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--sky-action) 70%, transparent));
  }
  .prp-stage__packet--in  { offset-path: path('M 56 200 L 200 200'); offset-rotate: 0deg; }
  .prp-stage__packet--out { offset-path: path('M 200 200 L 344 200'); offset-rotate: 0deg; }

  @media (prefers-reduced-motion: no-preference) {
    .prp-stage__flow { animation: prp-arc 3.2s linear infinite; }

    .prp-stage__pulse rect {
      animation: prp-pulse 3.8s ease-out infinite;
      transform-origin: 200px 200px;
      transform-box: fill-box;
    }
    .prp-stage__pulse rect:nth-child(2) { animation-delay: 1.4s; }

    .prp-stage__packet--in  { animation: prp-packet 4s ease-in-out infinite; }
    .prp-stage__packet--out { animation: prp-packet 4s ease-in-out infinite; animation-delay: 2s; }

    .prp-stage__led { animation: prp-led 2s ease-in-out infinite; }
    .prp-stage__led--2 { animation-delay: 0.3s; }
    .prp-stage__led--3 { animation-delay: 0.6s; }
    .prp-stage__led--4 { animation-delay: 0.9s; }
    .prp-stage__led--5 { animation-delay: 1.2s; }
    .prp-stage__led--6 { animation-delay: 1.5s; }

    @keyframes prp-arc { to { stroke-dashoffset: -22; } }
    @keyframes prp-pulse {
      0%   { opacity: 0.55; transform: scale(0.9); }
      70%  { opacity: 0;    transform: scale(1.15); }
      100% { opacity: 0;    transform: scale(1.15); }
    }
    @keyframes prp-packet {
      0%   { offset-distance: 0%;   opacity: 0; }
      10%  { opacity: 1; }
      90%  { offset-distance: 100%; opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    @keyframes prp-led {
      0%, 100% { opacity: 1; }
      50%      { opacity: 0.35; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prp-stage__flow,
    .prp-stage__pulse rect,
    .prp-stage__packet,
    .prp-stage__led { animation: none; }
    .prp-stage__packet { display: none; }
  }
</style>
