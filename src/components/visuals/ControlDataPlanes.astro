---
import ProviderLogo from '../ui/ProviderLogo.astro';
import { ShieldCheck, ListChecks, CalendarClock, ScrollText } from '@lucide/astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
const altLabel = t('visuals.controlDataPlanes.alt');
const controlTitle = t('visuals.controlDataPlanes.controlTitle');
const dataTitle = t('visuals.controlDataPlanes.dataTitle');
const metadataLabel = t('visuals.controlDataPlanes.metadataLabel');
const authLabel = t('visuals.controlDataPlanes.auth');
const jobsLabel = t('visuals.controlDataPlanes.jobs');
const schedulesLabel = t('visuals.controlDataPlanes.schedules');
const logsLabel = t('visuals.controlDataPlanes.logs');
const runnerLabel = t('visuals.controlDataPlanes.runner');
const sourceLabel = t('visuals.controlDataPlanes.source');
const destinationLabel = t('visuals.controlDataPlanes.destination');

type Dir = 'down' | 'up' | 'both';
const chips = [
  { icon: ShieldCheck, label: authLabel, cx: 62, dir: 'down' as Dir, hue: 'oklch(0.58 0.16 150)' },
  { icon: ListChecks, label: jobsLabel, cx: 154, dir: 'both' as Dir, hue: 'oklch(0.48 0.19 252)' },
  { icon: CalendarClock, label: schedulesLabel, cx: 246, dir: 'both' as Dir, hue: 'oklch(0.56 0.19 305)' },
  { icon: ScrollText, label: logsLabel, cx: 338, dir: 'up' as Dir, hue: 'oklch(0.66 0.16 65)' },
] as const;

const packets = chips.flatMap((c, i) => {
  if (c.dir === 'down') return [{ i, direction: 'down' as const, cx: c.cx, hue: c.hue }];
  if (c.dir === 'up') return [{ i, direction: 'up' as const, cx: c.cx, hue: c.hue }];
  return [
    { i, direction: 'down' as const, cx: c.cx, hue: c.hue },
    { i, direction: 'up' as const, cx: c.cx, hue: c.hue },
  ];
});
---

<div class="cdp-card-shadow squircle-elevation">
<div class="cdp-card glass-pane" data-squircle data-squircle-radius="26">
<div class="cdp-stage" role="img" aria-label={altLabel}>
  <svg class="cdp-stage__sky" viewBox="0 0 400 400" aria-hidden="true">
    <defs>
      <radialGradient id="cdp-bloom" cx="50%" cy="50%" r="55%">
        <stop offset="0%"  stop-color="var(--sky-action)" stop-opacity="0.18" />
        <stop offset="55%" stop-color="var(--sky-action)" stop-opacity="0.04" />
        <stop offset="100%" stop-color="var(--sky-action)" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="cdp-flow" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"  stop-color="var(--sky-action)" stop-opacity="0.15" />
        <stop offset="50%" stop-color="var(--sky-action)" stop-opacity="0.65" />
        <stop offset="100%" stop-color="var(--sky-action)" stop-opacity="0.15" />
      </linearGradient>
      <linearGradient id="cdp-branch" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%"  stop-color="var(--sky-action)" stop-opacity="0.65" />
        <stop offset="100%" stop-color="var(--sky-action)" stop-opacity="0.25" />
      </linearGradient>
    </defs>

    <circle cx="200" cy="200" r="180" fill="url(#cdp-bloom)" />

    <!-- Control plane perimeter -->
    <rect x="6" y="20" width="388" height="156" rx="28"
      fill="color-mix(in srgb, var(--sky-action) 5%, transparent)"
      stroke="color-mix(in srgb, var(--sky-action) 50%, transparent)"
      stroke-width="1.4" stroke-dasharray="5 7" />

    <!-- Data plane perimeter -->
    <rect x="6" y="240" width="388" height="160" rx="28"
      fill="color-mix(in srgb, var(--sky-action) 5%, transparent)"
      stroke="color-mix(in srgb, var(--sky-action) 50%, transparent)"
      stroke-width="1.4" stroke-dasharray="5 7" />

    <!-- The road: a trunk from data plane top, then 4 branches fanning out to each chip.
         Each branch carries its chip's hue. -->
    <g class="cdp-stage__road" aria-hidden="true">
      {chips.map((c) => (
        <path class="cdp-stage__lane"
          d={`M 200 296 V 188 H ${c.cx} V 118`}
          fill="none"
          stroke={c.hue}
          stroke-opacity="0.55"
          stroke-width="1.6" stroke-linecap="round" />
      ))}
    </g>

    <!-- Data plane horizontal flow (source → runner → destination) -->
    <path class="cdp-stage__flow"
      d="M 56 310 L 344 310"
      fill="none" stroke="url(#cdp-flow)" stroke-width="1.6"
      stroke-dasharray="4 6" stroke-linecap="round" />

    <g class="cdp-stage__pulse">
      <rect x="166" y="282" width="68" height="56" rx="16" fill="none"
        stroke="var(--sky-action)" stroke-opacity="0.18" />
      <rect x="156" y="272" width="88" height="76" rx="20" fill="none"
        stroke="var(--sky-action)" stroke-opacity="0.10" />
    </g>

    <!-- Packets per branch, directionality matches each control-plane resource -->
    <g class="cdp-stage__packets" aria-hidden="true">
      {packets.map((p, idx) => (
        <circle class={`cdp-stage__packet cdp-stage__packet--meta cdp-stage__packet--meta-${p.i}-${p.direction} cdp-stage__packet--slot-${idx}`}
          style={`fill: ${p.hue}; --packet-hue: ${p.hue};`}
          cx="0" cy="0" r="4" />
      ))}
      <rect class="cdp-stage__packet cdp-stage__packet--flow" x="-9" y="-5" width="18" height="10" rx="2.5" />
    </g>

  </svg>

  <span class="cdp-stage__plane-badge cdp-stage__plane-badge--control">{controlTitle}</span>
  <span class="cdp-stage__plane-badge cdp-stage__plane-badge--data">{dataTitle}</span>

  <ul class="cdp-stage__chip-row" role="list">
    {chips.map(({ icon: Icon, label, hue }) => (
      <li class="cdp-stage__chip" data-squircle data-squircle-radius="14" style={`--chip-hue: ${hue};`}>
        <span class="cdp-stage__chip-icon" aria-hidden="true">
          <Icon size={16} strokeWidth={1.75} />
        </span>
        <span class="cdp-stage__chip-label">{label}</span>
      </li>
    ))}
  </ul>

  <span class="cdp-stage__meta-pill" aria-hidden="true">{metadataLabel}</span>

  <div class="cdp-stage__node cdp-stage__node--source">
    <div class="cdp-stage__node-inner cdp-decoration" data-squircle data-squircle-radius="16">
      <ProviderLogo provider="google-drive" size={28} />
    </div>
    <span class="cdp-stage__node-label">{sourceLabel}</span>
  </div>

  <div class="cdp-stage__runner cdp-decoration" data-squircle data-squircle-radius="18">
    <span class="cdp-stage__slot">
      <span class="cdp-stage__led cdp-stage__led--1"></span>
      <span class="cdp-stage__bar"></span>
    </span>
    <span class="cdp-stage__slot">
      <span class="cdp-stage__led cdp-stage__led--2"></span>
      <span class="cdp-stage__bar"></span>
    </span>
    <span class="cdp-stage__slot">
      <span class="cdp-stage__led cdp-stage__led--3"></span>
      <span class="cdp-stage__bar"></span>
    </span>
    <span class="cdp-stage__runner-label">{runnerLabel}</span>
  </div>

  <div class="cdp-stage__node cdp-stage__node--dest">
    <div class="cdp-stage__node-inner cdp-decoration" data-squircle data-squircle-radius="16">
      <ProviderLogo provider="dropbox" size={28} />
    </div>
    <span class="cdp-stage__node-label">{destinationLabel}</span>
  </div>
</div>
</div>
</div>

<style>
  .cdp-card-shadow {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
  }
  .cdp-card {
    padding: 18px;
    width: 100%;
  }
  .cdp-decoration {
    background: color-mix(in srgb, var(--sky-action) 8%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sky-action) 22%, transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 0;
  }
  .cdp-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    isolation: isolate;
    display: block;
    padding-block: 32px;
  }
  .cdp-stage__sky {
    position: absolute;
    inset: 32px 0;
    width: 100%;
    height: calc(100% - 64px);
    pointer-events: none;
  }
  /* Plane badges — sit on the top-left edge of each plane perimeter */
  .cdp-stage__plane-badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--sky-action) 14%, transparent);
    color: var(--sky-action);
    white-space: nowrap;
    z-index: 3;
    line-height: 1;
  }
  .cdp-stage__plane-badge--control {
    left: 50%;
    top: 4px;
    transform: translateX(-50%);
  }
  .cdp-stage__plane-badge--data {
    left: 50%;
    bottom: 4px;
    transform: translateX(-50%);
  }

  /* Control-plane chip row — inside the top plane area */
  .cdp-stage__chip-row {
    position: absolute;
    top: 19%;
    left: 10%;
    right: 10%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 2;
  }
  .cdp-stage__chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 6px 8px;
    text-align: center;
    background: color-mix(in srgb, var(--chip-hue, var(--sky-action)) 8%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--chip-hue, var(--sky-action)) 28%, transparent);
  }
  .cdp-stage__chip-icon {
    display: inline-flex;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: color-mix(in srgb, var(--chip-hue, var(--sky-action)) 16%, transparent);
    color: var(--chip-hue, var(--sky-action));
  }
  .cdp-stage__chip-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  /* Metadata pill — sits at the road trunk where the 4 branches diverge */
  .cdp-stage__meta-pill {
    position: absolute;
    top: 52%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--sky-action);
    background: var(--glass-bg-strong);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sky-action) 40%, transparent);
    padding: 3px 9px;
    border-radius: 999px;
    z-index: 4;
    white-space: nowrap;
  }

  /* Source / destination nodes — inside the bottom plane area */
  .cdp-stage__node {
    position: absolute;
    top: 71%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    z-index: 2;
  }
  .cdp-stage__node--source { left: 9%; }
  .cdp-stage__node--dest   { right: 9%; }
  .cdp-stage__node-inner {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cdp-stage__node-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  /* Center runner — inside the bottom plane area */
  .cdp-stage__runner {
    position: absolute;
    top: 70%;
    left: 50%;
    transform: translateX(-50%);
    width: 24%;
    aspect-ratio: 1.4 / 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px 22px;
    z-index: 2;
  }
  .cdp-stage__slot {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cdp-stage__led {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sky-action);
    box-shadow: 0 0 4px color-mix(in srgb, var(--sky-action) 60%, transparent);
  }
  .cdp-stage__bar {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sky-action) 22%, transparent);
  }
  .cdp-stage__runner-label {
    position: absolute;
    bottom: 6px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--sky-action);
    text-transform: uppercase;
  }

  /* Packets */
  .cdp-stage__packet {
    fill: var(--sky-action);
    opacity: 0;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--packet-hue, var(--sky-action)) 70%, transparent));
  }
  /* "down" = control-plane chip → runner. "up" = runner → control-plane chip.
     Each path is written so offset-distance 0% is the chip and 100% is the runner
     for "down", and the reverse for "up". */
  .cdp-stage__packet--meta-0-down { offset-path: path('M 62 118 V 188 H 200 V 296'); }
  .cdp-stage__packet--meta-1-down { offset-path: path('M 154 118 V 188 H 200 V 296'); }
  .cdp-stage__packet--meta-2-down { offset-path: path('M 246 118 V 188 H 200 V 296'); }
  .cdp-stage__packet--meta-1-up   { offset-path: path('M 200 296 V 188 H 154 V 118'); }
  .cdp-stage__packet--meta-2-up   { offset-path: path('M 200 296 V 188 H 246 V 118'); }
  .cdp-stage__packet--meta-3-up   { offset-path: path('M 200 296 V 188 H 338 V 118'); }
  .cdp-stage__packet--meta { offset-rotate: 0deg; }
  .cdp-stage__packet--flow {
    offset-path: path('M 56 310 L 344 310');
    offset-rotate: 0deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cdp-stage__lane { animation: cdp-arc 3.5s linear infinite; }
    .cdp-stage__flow { animation: cdp-arc 3.2s linear infinite; }
    .cdp-stage__pulse rect {
      animation: cdp-pulse 3.6s ease-out infinite;
      transform-origin: 200px 310px;
      transform-box: fill-box;
    }
    .cdp-stage__pulse rect:nth-child(2) { animation-delay: 1.2s; }

    .cdp-stage__packet--meta { animation: cdp-packet-meta 4s ease-in-out infinite; }
    .cdp-stage__packet--slot-0 { animation-delay: 0s; }
    .cdp-stage__packet--slot-1 { animation-delay: 0.3s; }
    .cdp-stage__packet--slot-2 { animation-delay: 0.6s; }
    .cdp-stage__packet--slot-3 { animation-delay: 0.9s; }
    .cdp-stage__packet--slot-4 { animation-delay: 1.2s; }
    .cdp-stage__packet--slot-5 { animation-delay: 1.5s; }

    .cdp-stage__packet--flow { animation: cdp-packet-flow 3.6s ease-in-out infinite; }

    .cdp-stage__led { animation: cdp-led 1.8s ease-in-out infinite; }
    .cdp-stage__led--2 { animation-delay: 0.4s; }
    .cdp-stage__led--3 { animation-delay: 0.8s; }

    @keyframes cdp-arc {
      to { stroke-dashoffset: -16; }
    }
    @keyframes cdp-pulse {
      0%   { opacity: 0.5; transform: scale(0.9); }
      60%  { opacity: 0;   transform: scale(1.15); }
      100% { opacity: 0;   transform: scale(1.15); }
    }
    @keyframes cdp-packet-meta {
      0%   { offset-distance: 0%;   opacity: 0; }
      10%  { opacity: 1; }
      85%  { offset-distance: 100%; opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    @keyframes cdp-packet-flow {
      0%   { offset-distance: 0%;   opacity: 0; }
      8%   { opacity: 1; }
      92%  { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    @keyframes cdp-led {
      0%, 100% { opacity: 1; }
      50%      { opacity: 0.35; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cdp-stage__lane,
    .cdp-stage__flow,
    .cdp-stage__pulse rect,
    .cdp-stage__packet,
    .cdp-stage__led { animation: none; }
    .cdp-stage__packet { display: none; }
  }
</style>
