---
import ProviderLogo from '../ui/ProviderLogo.astro';

interface Props {
  ariaLabel?: string;
}
const { ariaLabel = 'Syncologic connects Google Drive, OneDrive, Dropbox, and S3' } = Astro.props;

const providers = [
  { id: 'google-drive', label: 'Google Drive', pos: 'n'  },
  { id: 'dropbox',      label: 'Dropbox',      pos: 'e'  },
  { id: 's3',           label: 'S3',           pos: 's'  },
  { id: 'onedrive',     label: 'OneDrive',     pos: 'w'  },
] as const;
---

<div class="constellation" role="img" aria-label={ariaLabel}>
  <svg class="constellation__arcs" viewBox="0 0 400 400" aria-hidden="true">
    <defs>
      <radialGradient id="constellation-bloom" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--sky-action)" stop-opacity="0.18" />
        <stop offset="55%" stop-color="var(--sky-action)" stop-opacity="0.05" />
        <stop offset="100%" stop-color="var(--sky-action)" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="constellation-stroke" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--sky-action)" stop-opacity="0.55" />
        <stop offset="100%" stop-color="var(--sky-action)" stop-opacity="0.15" />
      </linearGradient>
    </defs>

    <circle cx="200" cy="200" r="160" fill="url(#constellation-bloom)" />

    <g stroke="url(#constellation-stroke)" stroke-width="1.2" fill="none" stroke-linecap="round">
      <path class="arc arc--n" d="M200 200 L200 64"  stroke-dasharray="3 6" />
      <path class="arc arc--e" d="M200 200 L348 200" stroke-dasharray="3 6" />
      <path class="arc arc--s" d="M200 200 L200 336" stroke-dasharray="3 6" />
      <path class="arc arc--w" d="M200 200 L52 200"  stroke-dasharray="3 6" />
    </g>

    <g class="pulse">
      <circle cx="200" cy="200" r="118" fill="none" stroke="var(--sky-action)" stroke-opacity="0.18" />
      <circle cx="200" cy="200" r="148" fill="none" stroke="var(--sky-action)" stroke-opacity="0.10" />
    </g>

    <g class="packets" aria-hidden="true">
      <rect class="packet packet--ne" x="-7" y="-5" width="14" height="10" rx="2.5" />
      <rect class="packet packet--es" x="-7" y="-5" width="14" height="10" rx="2.5" />
      <rect class="packet packet--sw" x="-7" y="-5" width="14" height="10" rx="2.5" />
    </g>
  </svg>

  <div class="constellation__core glass-pane" data-squircle data-squircle-radius="22">
    <img src="/assets/brand/icon_white_background.svg" alt="" width="44" height="44" class="constellation__mark theme-asset-day" />
    <img src="/assets/brand/icon_dark_background.svg"  alt="" width="44" height="44" class="constellation__mark theme-asset-night" />
  </div>

  {providers.map((p) => (
    <div class={`constellation__chip constellation__chip--${p.pos}`}>
      <div class="constellation__chip-inner glass-pane" data-squircle data-squircle-radius="18">
        <ProviderLogo provider={p.id} size={36} />
        <span class="constellation__chip-label">{p.label}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .constellation {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
  }

  .constellation__arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .arc {
    stroke-dashoffset: 0;
    animation: arc-flow 6s linear infinite;
  }
  .arc--e { animation-delay: -1.5s; }
  .arc--s { animation-delay: -3s; }
  .arc--w { animation-delay: -4.5s; }

  @keyframes arc-flow {
    to { stroke-dashoffset: -36; }
  }

  /* file packets travelling provider -> center -> provider along the arcs.
     Different durations per packet + offbeat negative delays keep the
     three trips from ever sharing a heartbeat. */
  .packet {
    fill: var(--sky-action);
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--sky-action) 60%, transparent));
    opacity: 0;
  }
  .packet--ne {
    offset-path: path('M 200 64  L 200 200 L 348 200');
    animation: packet-trip 5.2s cubic-bezier(0.5, 0, 0.5, 1) -0.3s infinite,
               packet-fade 5.2s linear -0.3s infinite;
  }
  .packet--es {
    offset-path: path('M 348 200 L 200 200 L 200 336');
    animation: packet-trip 6.7s cubic-bezier(0.5, 0, 0.5, 1) -2.4s infinite,
               packet-fade 6.7s linear -2.4s infinite;
  }
  .packet--sw {
    offset-path: path('M 200 336 L 200 200 L 52  200');
    animation: packet-trip 4.3s cubic-bezier(0.5, 0, 0.5, 1) -1.1s infinite,
               packet-fade 4.3s linear -1.1s infinite;
  }

  @keyframes packet-trip {
    from { offset-distance: 0%; }
    to   { offset-distance: 100%; }
  }
  /* Tighter visible window with idle gap at the end so packets don't
     all overlap — each trip vanishes for ~25% of its cycle. */
  @keyframes packet-fade {
    0%   { opacity: 0; transform: scale(0.7); }
    8%   { opacity: 1; transform: scale(1); }
    40%  { opacity: 1; transform: scale(1.15); }
    60%  { opacity: 1; transform: scale(1.15); }
    74%  { opacity: 1; transform: scale(1); }
    78%  { opacity: 0; transform: scale(0.7); }
    100% { opacity: 0; transform: scale(0.7); }
  }

  .pulse circle {
    transform-origin: 200px 200px;
    animation: pulse 4.8s ease-in-out infinite;
  }
  .pulse circle:nth-child(2) { animation-delay: 1.2s; }

  @keyframes pulse {
    0%, 100% { transform: scale(0.96); opacity: 0.55; }
    50%      { transform: scale(1.02); opacity: 1; }
  }

  .constellation__core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30%;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    filter: var(--drop-shadow-sky-lg);
    animation: float-core 9s ease-in-out infinite;
  }
  .constellation__mark { width: 48%; height: auto; }

  @keyframes float-core {
    0%, 100% { transform: translate(-50%, -50%); }
    50%      { transform: translate(-50%, calc(-50% - 6px)); }
  }

  .constellation__chip {
    position: absolute;
    width: 30%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }
  .constellation__chip--n { top: 0;    left: 50%; transform: translate(-50%, 0); }
  .constellation__chip--e { top: 50%;  right: 0;  transform: translate(0, -50%); }
  .constellation__chip--s { bottom: 0; left: 50%; transform: translate(-50%, 0); }
  .constellation__chip--w { top: 50%;  left: 0;   transform: translate(0, -50%); }

  .constellation__chip-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px;
    filter: var(--drop-shadow-sky-md);
    will-change: transform;
  }
  .constellation__chip--n .constellation__chip-inner { animation: float-y 7s ease-in-out infinite; }
  .constellation__chip--e .constellation__chip-inner { animation: float-x 8s ease-in-out -1.4s infinite; }
  .constellation__chip--s .constellation__chip-inner { animation: float-y 9s ease-in-out -3.2s infinite reverse; }
  .constellation__chip--w .constellation__chip-inner { animation: float-x 7.5s ease-in-out -2.1s infinite reverse; }

  @keyframes float-y {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  @keyframes float-x {
    0%, 100% { transform: translateX(0); }
    50%      { transform: translateX(-8px); }
  }

  .constellation__chip-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .constellation { max-width: 360px; }
    .constellation__chip-label { font-size: 10px; }
    .constellation__chip--e { right: 4%; }
    .constellation__chip--w { left: 4%; }
    .constellation__chip { width: 34%; aspect-ratio: 1.15 / 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc,
    .pulse circle,
    .constellation__core,
    .constellation__chip-inner,
    .packet {
      animation: none !important;
    }
    .packet { opacity: 0; }
  }
</style>
