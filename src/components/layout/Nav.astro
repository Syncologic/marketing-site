---
import { Languages, ChevronDown } from '@lucide/astro';
import GithubIcon from '../ui/GithubIcon.astro';
import { getLocaleFromUrl, getT, localizedPath, pathWithoutLocale } from '../../i18n/utils';

const GITHUB_URL = 'https://github.com/syncologic';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
const path = pathWithoutLocale(Astro.url.pathname);

const isGuide = path === '/guides' || path.startsWith('/guides/');
const positionClass = isGuide ? 'absolute' : 'fixed';
---

<header
  class={`${positionClass} top-3 left-4 right-4 lg:top-4 lg:left-6 lg:right-6 lg:mx-auto lg:max-w-[1560px] z-50 nav-floating`}
  data-locale={locale}
>
  <div class="nav-bg nav-glass" data-squircle data-squircle-radius="22" aria-hidden="true"></div>
  <nav class="relative flex items-center gap-7 h-14 lg:h-16 px-5 lg:px-8 max-w-[1560px] mx-auto">
    <a href={localizedPath(locale, '/')} class="flex items-center gap-3 shrink-0">
      <img src="/assets/brand/icon_white_background.svg" alt="" width="44" height="44" class="theme-asset-day rounded-input w-9 h-9 lg:w-11 lg:h-11" />
      <img src="/assets/brand/icon_dark_background.svg" alt="" width="44" height="44" class="theme-asset-night rounded-input w-9 h-9 lg:w-11 lg:h-11" />
      <span class="text-xl lg:text-h2 font-bold tracking-tight leading-none text-[var(--brand-text)]">{t('site.name')}</span>
    </a>

    <ul class="nav-center hidden lg:flex items-center gap-1 list-none p-0 m-0">
      <li style="position: relative;">
        <button
          type="button"
          data-uc-toggle
          class="nav-link"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="uc-menu"
        >
          <span>{t('nav.useCases')}</span>
          <ChevronDown size={14} strokeWidth={2} aria-hidden="true" />
        </button>
        <ul
          id="uc-menu"
          data-uc-menu
          data-squircle
          data-squircle-radius="18"
          class="hidden w-64 glass glass-strong px-2 py-2 list-none m-0"
          role="menu"
          style="position: absolute; top: calc(100% + 0.5rem); left: 50%; transform: translateX(-50%); z-index: 60;"
        >
          <li>
            <a href={localizedPath(locale, '/use-cases/cloud-to-cloud-transfer')} class="uc-menu-item" role="menuitem">
              {t('nav.useCasesMenu.cloudToCloud')}
            </a>
          </li>
          <li>
            <a href={localizedPath(locale, '/use-cases/business-cloud-migration')} class="uc-menu-item" role="menuitem">
              {t('nav.useCasesMenu.businessMigration')}
            </a>
          </li>
          <li>
            <a href={localizedPath(locale, '/use-cases/scheduled-cloud-backup')} class="uc-menu-item" role="menuitem">
              {t('nav.useCasesMenu.scheduledBackup')}
            </a>
          </li>
        </ul>
      </li>
      <li>
        <a href={localizedPath(locale, '/self-hosted')} class="nav-link">{t('nav.selfHosted')}</a>
      </li>
      <li>
        <a href={localizedPath(locale, '/developers')} class="nav-link">{t('nav.developers')}</a>
      </li>
    </ul>

    <div class="flex items-center gap-2 sm:gap-3 ml-auto">
      <div data-lang-switcher style="position: relative;">
        <button
          type="button"
          data-lang-toggle
          class="inline-flex items-center justify-center w-9 h-9 rounded-input text-ink hover:bg-[var(--glass-tint)] transition-colors cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label={t('language.label')}
        >
          <Languages size={19} strokeWidth={1.8} />
        </button>
        <ul
          id="lang-menu"
          data-lang-menu
          data-squircle
          data-squircle-radius="16"
          class="hidden w-44 glass glass-strong px-3 py-1.5"
          role="menu"
          style="position: absolute; top: calc(100% + 0.5rem); right: 0; z-index: 60;"
        >
          <li>
            <a
              href={localizedPath('en', path)}
              hreflang="en"
              aria-current={locale === 'en' ? 'true' : undefined}
              class:list={[
                'flex items-center justify-between gap-2 px-3 py-2 text-caption rounded-input text-ink hover:bg-[var(--glass-tint)] transition-colors',
                locale === 'en' && 'font-semibold',
              ]}
              role="menuitem"
            >
              <span>{t('language.en')}</span>
              {locale === 'en' && <span aria-hidden="true" class="text-[var(--sky-action)]">✓</span>}
            </a>
          </li>
          <li>
            <a
              href={localizedPath('pt-br', path)}
              hreflang="pt-br"
              aria-current={locale === 'pt-br' ? 'true' : undefined}
              class:list={[
                'flex items-center justify-between gap-2 px-3 py-2 text-caption rounded-input text-ink hover:bg-[var(--glass-tint)] transition-colors',
                locale === 'pt-br' && 'font-semibold',
              ]}
              role="menuitem"
            >
              <span>{t('language.pt-br')}</span>
              {locale === 'pt-br' && <span aria-hidden="true" class="text-[var(--sky-action)]">✓</span>}
            </a>
          </li>
        </ul>
      </div>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-9 h-9 rounded-input text-ink hover:bg-[var(--glass-tint)] transition-colors"
        aria-label="GitHub"
      >
        <GithubIcon size={19} />
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle relative inline-flex items-center justify-center w-9 h-9 rounded-input cursor-pointer transition-colors"
        aria-label="Switch theme"
        title="Switch sky"
      >
        <svg data-theme-icon="sun" class="theme-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg data-theme-icon="moon" class="theme-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border-radius: 22px;
  }
  .nav-glass {
    background-color: var(--glass-bg-strong);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    box-shadow: var(--shadow-sky-md);
  }
  .nav-floating {
    /* box-shadow lives on .nav-glass so it follows the rounded silhouette
       through the backdrop-filter stacking context. */
  }
  .nav-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: background 160ms;
  }
  .nav-link:hover { background: var(--glass-tint); }

  [data-uc-menu] { box-shadow: var(--glass-shadow); }
  [data-uc-menu]::before { content: none !important; }
  .uc-menu-item {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--ink);
    transition: background 160ms;
  }
  .uc-menu-item:hover { background: var(--glass-tint); }
  [data-lang-menu] {
    box-shadow: var(--glass-shadow);
  }
  [data-lang-menu]::before {
    content: none !important;
  }
  .theme-toggle {
    color: var(--ink);
    background: transparent;
  }
  .theme-toggle:hover {
    background: var(--glass-tint);
  }
  .theme-icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition:
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :root[data-celestial='sun'] .theme-toggle [data-theme-icon='sun'] {
    opacity: 1; transform: rotate(0) scale(1);
  }
  :root[data-celestial='sun'] .theme-toggle [data-theme-icon='moon'] {
    opacity: 0; transform: rotate(-60deg) scale(0.6);
  }
  :root[data-celestial='moon'] .theme-toggle [data-theme-icon='sun'] {
    opacity: 0; transform: rotate(60deg) scale(0.6);
  }
  :root[data-celestial='moon'] .theme-toggle [data-theme-icon='moon'] {
    opacity: 1; transform: rotate(0) scale(1);
  }
</style>

<script>
  function effectiveTheme(): 'day' | 'night' {
    const explicit = document.documentElement.dataset.theme;
    if (explicit === 'day' || explicit === 'night') return explicit;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
  }
  function syncCelestial() {
    document.documentElement.dataset.celestial = effectiveTheme() === 'night' ? 'moon' : 'sun';
  }
  syncCelestial();

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    themeToggle.addEventListener('click', () => {
      const next = effectiveTheme() === 'night' ? 'day' : 'night';
      const root = document.documentElement;
      const commit = () => {
        root.dataset.theme = next;
        root.dataset.celestial = next === 'night' ? 'moon' : 'sun';
        try { localStorage.setItem('sky-theme', next); } catch {}
      };

      // @ts-expect-error startViewTransition is not in stable TS DOM yet
      if (reduced.matches || typeof document.startViewTransition !== 'function') {
        commit();
        return;
      }

      // @ts-expect-error startViewTransition is not in stable TS DOM yet
      document.startViewTransition(commit);
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncCelestial);
  }
</script>

<script>
  type Popover = { toggle: HTMLButtonElement; menu: HTMLElement; setOpen: (open: boolean) => void };

  const popovers: Popover[] = [];

  function wirePopover(toggleSel: string, menuSel: string): Popover | null {
    const toggle = document.querySelector<HTMLButtonElement>(toggleSel);
    const menu = document.querySelector<HTMLElement>(menuSel);
    if (!toggle || !menu) return null;
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      for (const p of popovers) if (p.toggle !== toggle) p.setOpen(false);
      setOpen(!expanded);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    return { toggle, menu, setOpen };
  }

  const langPop = wirePopover('[data-lang-toggle]', '[data-lang-menu]');
  if (langPop) popovers.push(langPop);
  const ucPop = wirePopover('[data-uc-toggle]', '[data-uc-menu]');
  if (ucPop) popovers.push(ucPop);

  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Node;
    for (const p of popovers) {
      if (p.toggle.getAttribute('aria-expanded') !== 'true') continue;
      if (p.menu.contains(target) || p.toggle.contains(target)) continue;
      p.setOpen(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const p of popovers) {
      if (p.toggle.getAttribute('aria-expanded') === 'true') {
        p.setOpen(false);
        p.toggle.focus();
      }
    }
  });
</script>
