---
import ProviderLogo from '../ui/ProviderLogo.astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);

const providers = [
  { id: 'google-drive' as const, key: 'googleDrive' },
  { id: 'onedrive' as const, key: 'oneDrive' },
  { id: 'dropbox' as const, key: 'dropbox' },
  { id: 's3' as const, key: 's3' },
  { id: 'sftp' as const, key: 'sftp' },
  { id: 'webdav' as const, key: 'webdav' },
  { id: 'nextcloud' as const, key: 'nextcloud' },
];
---

<ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-y-8 gap-x-6 sm:gap-x-8 lg:gap-x-10 max-w-md sm:max-w-2xl lg:max-w-none mx-auto px-4 py-6 [&>li:last-child]:col-span-2 sm:[&>li:last-child]:col-span-3 lg:[&>li:last-child]:col-span-1">
  {providers.map((p) => (
    <li class="flex flex-col items-center gap-3 text-caption text-slate-gray whitespace-nowrap">
      <ProviderLogo provider={p.id} size={56} />
      <span>{t(`providers.${p.key}`)}</span>
    </li>
  ))}
</ul>
