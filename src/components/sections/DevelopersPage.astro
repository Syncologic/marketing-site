---
import Section from '../ui/Section.astro';
import Hero from './Hero.astro';
import FAQ from './FAQ.astro';
import WaitlistForm from './WaitlistForm.astro';
import HeroEmailCapture from './HeroEmailCapture.astro';
import WaitlistJoinedCard from './WaitlistJoinedCard.astro';
import DeveloperTerminal from '../visuals/DeveloperTerminal.astro';
import OAuthIntermediary from '../visuals/OAuthIntermediary.astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';
import en from '../../i18n/en.json';
import ptBr from '../../i18n/pt-br.json';

const locale = getLocaleFromUrl(Astro.url);
const dict = (locale === 'pt-br' ? ptBr : en) as typeof en;
const dev = dict.developers;
const t = getT(locale);

const apiSnippet = `POST /v1/jobs
Authorization: Bearer sk_live_…
Content-Type: application/json

{
  "source":      { "provider": "google_drive", "path": "/Marketing" },
  "destination": { "provider": "s3", "bucket": "acme-archive", "prefix": "marketing/" },
  "runner":      "cloud",
  "schedule":    "0 2 * * *",
  "on_conflict": "skip"
}`;

const cliSnippet = `syncologic jobs create \\
  --source google_drive:/Marketing \\
  --destination s3://acme-archive/marketing/ \\
  --runner cloud \\
  --schedule "0 2 * * *" \\
  --on-conflict skip`;

---

<Hero
  surface="sky"
  eyebrow={dev.heroEyebrow}
  eyebrowAsBadge
  headline={dev.heroHeadline}
  subheading={dev.heroSubheading}
  primaryCta={{ label: dev.heroPrimaryCta, href: '#waitlist' }}
>
  <p slot="meta" class="text-caption text-ink-soft max-w-[640px]">{dev.audienceLabel}</p>
  <Fragment slot="cta">
    <div class="dev-hero-join" data-join-swap data-joined-state="cta">
      <button type="button" class="dev-hero-join__btn btn-primary-glass px-[26px] py-[14px] text-[16px] font-semibold" data-cta-trigger>
        {t('waitlist.earlyAccessCta')}
      </button>
      <div class="dev-hero-join__form-shadow">
        <div class="dev-hero-join__form glass" data-squircle data-squircle-radius="22">
          <HeroEmailCapture segmentHint="developer" />
        </div>
      </div>
      <div class="dev-hero-join__joined">
        <WaitlistJoinedCard />
      </div>
    </div>
  </Fragment>
  <Fragment slot="visual">
    <DeveloperTerminal />
  </Fragment>
</Hero>

<style>
  .dev-hero-join {
    display: grid;
    grid-template-areas: 'stack';
    width: 100%;
    max-width: 520px;
    place-items: center stretch;
  }
  .dev-hero-join__btn,
  .dev-hero-join__form-shadow,
  .dev-hero-join__joined {
    grid-area: stack;
    transition:
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .dev-hero-join__btn {
    justify-self: center;
    align-self: center;
    cursor: pointer;
  }
  .dev-hero-join__form-shadow {
    display: flex;
    flex-direction: column;
    filter: var(--drop-shadow-sky-md) blur(6px);
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
  }
  .dev-hero-join__joined {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px) scale(0.985);
  }
  .dev-hero-join__form { padding: 8px; border-radius: 22px; }

  [data-joined-state='form'] .dev-hero-join__btn {
    opacity: 0;
    transform: scale(0.72);
    pointer-events: none;
    box-shadow: none;
  }
  [data-joined-state='form'] .dev-hero-join__form-shadow {
    opacity: 1;
    transform: scale(1);
    filter: var(--drop-shadow-sky-md) blur(0);
    pointer-events: auto;
  }

  [data-joined-state='joined'] .dev-hero-join__btn { opacity: 0; pointer-events: none; transform: scale(0.85); }
  [data-joined-state='joined'] .dev-hero-join__form-shadow {
    opacity: 0;
    transform: translateY(-8px) scale(0.985);
    filter: var(--drop-shadow-sky-md) blur(0);
    pointer-events: none;
  }
  [data-joined-state='joined'] .dev-hero-join__joined {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .dev-hero-join__form :global(.hero-email-capture > *) {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 280ms cubic-bezier(0.22, 1, 0.36, 1) 120ms,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1) 120ms;
  }
  .dev-hero-join__form :global(.hero-email-capture > *:nth-child(2)) { transition-delay: 200ms; }
  .dev-hero-join__form :global(.hero-email-capture > *:nth-child(3)) { transition-delay: 280ms; }
  [data-joined-state='form'] .dev-hero-join__form :global(.hero-email-capture > *) {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .dev-hero-join__btn,
    .dev-hero-join__form-shadow,
    .dev-hero-join__joined,
    .dev-hero-join__form :global(.hero-email-capture > *) { transition: none; filter: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-join-swap]').forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>('[data-cta-trigger]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      if (wrap.dataset.joinedState !== 'cta') return;
      wrap.dataset.joinedState = 'form';
      const email = wrap.querySelector<HTMLInputElement>('input[name="email"]');
      if (!email) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.setTimeout(() => email.focus({ preventScroll: true }), reduced ? 0 : 360);
    });
  });
</script>

<Section surface="tint" padding="lg" id="api" reveal class="mt-24 md:mt-40">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,760px)_minmax(0,1fr)] gap-12 items-start">
    <div class="bg-[oklch(0.18_0.03_255)] rounded-card p-6 sm:p-8">
      <pre class="text-caption text-white/90 font-mono whitespace-pre overflow-x-auto leading-relaxed"><code>{apiSnippet}</code></pre>
    </div>
    <div class="flex flex-col gap-3">
      <h2 class="text-h1 font-display font-bold text-ink">{dev.apiTitle}</h2>
      <p class="text-body text-ink">{dev.apiBody}</p>
      <p class="text-caption text-ink-soft">{dev.apiCaption}</p>
    </div>
  </div>
</Section>

<Section surface="sky" padding="lg" id="oauth" reveal class="mt-24 md:mt-40">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] gap-12 items-center">
    <div class="flex flex-col gap-3">
      <h2 class="text-h1 font-display font-bold text-ink">{dev.oauthTitle}</h2>
      <p class="text-body text-ink">{dev.oauthBody}</p>
      <p class="text-caption text-ink-soft">{dev.oauthCaption}</p>
    </div>
    <OAuthIntermediary />
  </div>
</Section>

<Section surface="tint" padding="lg" id="cli" reveal class="mt-24 md:mt-40">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,760px)_minmax(0,1fr)] gap-12 items-start">
    <div class="bg-[oklch(0.18_0.03_255)] rounded-card p-6 sm:p-8">
      <pre class="text-caption text-white/90 font-mono whitespace-pre overflow-x-auto leading-relaxed"><code>{cliSnippet}</code></pre>
    </div>
    <div class="flex flex-col gap-3">
      <h2 class="text-h1 font-display font-bold text-ink">{dev.cliTitle}</h2>
      <p class="text-body text-ink">{dev.cliBody}</p>
      <p class="text-caption text-ink-soft">{dev.cliCaption}</p>
    </div>
  </div>
</Section>

<Section surface="sky" padding="lg" id="webhooks" reveal class="mt-24 md:mt-40">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,540px)] gap-12 items-start">
    <div class="flex flex-col gap-3 max-w-[720px]">
      <h2 class="text-h1 font-display font-bold text-ink">{dev.webhooksTitle}</h2>
      <p class="text-body text-ink">{dev.webhooksBody}</p>
    </div>
    <div>
      <p class="text-caption font-medium uppercase tracking-wide text-ink-soft mb-4">{dev.webhookEventsLabel}</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 list-none p-0">
        {dev.webhookEvents.map((evt) => (
          <li class="flex items-center gap-3 px-4 py-3 bg-[var(--glass-bg)] rounded-pill [box-shadow:var(--shadow-sky-md)]">
            <span class="font-mono text-caption text-ink">{evt}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<Section surface="sky" padding="md" id="no-sdk" reveal class="mt-24 md:mt-40">
  <div class="max-w-3xl mx-auto text-center flex flex-col gap-4">
    <h2 class="text-h1 font-display font-bold text-ink">{dev.noSdkTitle}</h2>
    <p class="text-body text-ink">{dev.noSdkBody}</p>
  </div>
</Section>

<WaitlistForm segmentHint="developer" />

<FAQ title={dev.faqTitle} items={dev.faq} surface="tint" />
