---
import HeroEmailCapture from './HeroEmailCapture.astro';
import WaitlistJoinedCard from './WaitlistJoinedCard.astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
---

<div class="bottom-cta" data-bottom-cta>
  <div class="bottom-cta__copy">
    <h2 class="bottom-cta__title font-display">{t('homepage.bottomCtaTitle')}</h2>
    <p class="bottom-cta__subtitle">{t('homepage.bottomCtaSubtitle')}</p>
  </div>

  <div class="bottom-cta__join" data-join-swap data-joined-state="cta" data-bottom-cta-join>
    <button type="button" class="bottom-cta__btn" data-cta-trigger>
      {t('waitlist.earlyAccessCta')}
    </button>
    <div class="bottom-cta__form-shadow">
      <div class="bottom-cta__form glass" data-squircle data-squircle-radius="22">
        <HeroEmailCapture />
      </div>
    </div>
    <div class="bottom-cta__joined">
      <WaitlistJoinedCard />
    </div>
  </div>
</div>

<style>
  .bottom-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 3vw, 32px);
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }
  .bottom-cta__copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }
  .bottom-cta__title {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
    max-width: 18ch;
  }
  .bottom-cta__subtitle {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.5;
    color: var(--ink);
    max-width: 56ch;
  }

  .bottom-cta__join {
    display: grid;
    grid-template-areas: 'stack';
    width: 100%;
    max-width: 520px;
    place-items: center stretch;
  }
  .bottom-cta__btn,
  .bottom-cta__form-shadow,
  .bottom-cta__joined {
    grid-area: stack;
    transition:
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bottom-cta__form-shadow {
    display: flex;
    flex-direction: column;
    filter: var(--drop-shadow-sky-md) blur(6px);
  }

  .bottom-cta__btn {
    justify-self: center;
    align-self: center;
    appearance: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.005em;
    color: var(--on-action);
    background: var(--sky-action);
    border-radius: 999px;
    box-shadow:
      0 12px 28px -10px color-mix(in srgb, var(--sky-action) 60%, transparent),
      0 2px 6px -2px color-mix(in srgb, var(--sky-action) 35%, transparent);
    transition:
      background 200ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bottom-cta__btn:hover { background: var(--sky-action-hover); transform: translateY(-1px); }
  .bottom-cta__btn:focus-visible { outline: 3px solid var(--sky-action); outline-offset: 3px; }

  .bottom-cta__form-shadow,
  .bottom-cta__joined { opacity: 0; pointer-events: none; }
  .bottom-cta__form-shadow { transform: scale(0.92); }
  .bottom-cta__form { padding: 8px; border-radius: 22px; }
  .bottom-cta__joined { transform: translateY(8px) scale(0.985); }

  [data-joined-state='form'] .bottom-cta__btn {
    opacity: 0;
    transform: scale(0.72);
    pointer-events: none;
    box-shadow: none;
  }
  [data-joined-state='form'] .bottom-cta__form-shadow {
    opacity: 1;
    transform: scale(1);
    filter: var(--drop-shadow-sky-md) blur(0);
    pointer-events: auto;
  }

  [data-joined-state='joined'] .bottom-cta__btn { opacity: 0; pointer-events: none; transform: scale(0.85); }
  [data-joined-state='joined'] .bottom-cta__form-shadow {
    opacity: 0;
    transform: translateY(-8px) scale(0.985);
    filter: var(--drop-shadow-sky-md) blur(0);
    pointer-events: none;
  }
  [data-joined-state='joined'] .bottom-cta__joined {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .bottom-cta__form :global(.hero-email-capture > *) {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 280ms cubic-bezier(0.22, 1, 0.36, 1) 120ms,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1) 120ms;
  }
  .bottom-cta__form :global(.hero-email-capture > *:nth-child(2)) { transition-delay: 200ms; }
  .bottom-cta__form :global(.hero-email-capture > *:nth-child(3)) { transition-delay: 280ms; }
  [data-joined-state='form'] .bottom-cta__form :global(.hero-email-capture > *) {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .bottom-cta__btn,
    .bottom-cta__form-shadow,
    .bottom-cta__joined,
    .bottom-cta__form :global(.hero-email-capture > *) { transition: none; filter: none; }
  }

  [data-bottom-cta] {
    transition: opacity 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-bottom-cta][data-hidden='true'] {
    opacity: 0;
    pointer-events: none;
  }
</style>

<style is:global>
  section[data-bottom-cta-section] {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 520ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 520ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }
  section[data-bottom-cta-section] > * { min-height: 0; }
  section[data-bottom-cta-section][data-hidden='true'] {
    grid-template-rows: 0fr;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    section[data-bottom-cta-section],
    [data-bottom-cta] { transition: none; }
  }
</style>

<script>
  import { loadWaitlistState } from '../../lib/waitlist-storage';

  const inner = document.querySelector<HTMLElement>('[data-bottom-cta]');
  const wrap = document.querySelector<HTMLElement>('[data-bottom-cta-join]');
  const outer = inner?.closest<HTMLElement>('section');
  if (outer) outer.dataset.bottomCtaSection = '';
  if (inner && wrap && outer) {
    const trigger = wrap.querySelector<HTMLButtonElement>('[data-cta-trigger]');
    let initiatedFromBottom = false;
    let scheduled = false;

    trigger?.addEventListener('click', () => {
      initiatedFromBottom = true;
    });

    const hide = (instant = false) => {
      if (instant) {
        outer.style.transition = 'none';
        inner.style.transition = 'none';
      }
      inner.dataset.hidden = 'true';
      outer.dataset.hidden = 'true';
    };

    const scheduleHide = () => {
      if (scheduled) return;
      scheduled = true;
      const delay = initiatedFromBottom ? 3000 : 0;
      window.setTimeout(() => hide(false), delay);
    };

    if (loadWaitlistState()) {
      hide(true);
      scheduled = true;
    }

    window.addEventListener('waitlist:closed', scheduleHide);

    const mo = new MutationObserver(() => {
      if (wrap.dataset.joinedState === 'joined') scheduleHide();
    });
    mo.observe(wrap, { attributes: true, attributeFilter: ['data-joined-state'] });
  }
</script>
