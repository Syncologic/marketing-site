---
import Section from '../ui/Section.astro';
import ControlDataPlanes from '../visuals/ControlDataPlanes.astro';
import { Cog, Boxes, Rocket } from '@lucide/astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);

type Reason = { title: string; desc: string };
const reasons = t('selfHosted.update.reasons') as unknown as Reason[];
const reasonIcons = [Cog, Boxes, Rocket];
const controlDataParas = t('selfHosted.underTheHood.controlData.body') as unknown as string[];
---

<Section surface="sky" padding="lg" class="mt-8 lg:mt-16" id="update">
  <div class="max-w-[760px] mb-10">
    <h2 class="text-h1 font-display font-bold text-ink leading-tight mb-4">
      {t('selfHosted.update.title')}
    </h2>
    <p class="text-body text-ink">
      {t('selfHosted.update.intro')}
    </p>
  </div>

  <ol class="self-hosted-reasons grid grid-cols-1 md:grid-cols-3 gap-x-2 gap-y-10 list-none p-0">
    {reasons.map((reason, i) => {
      const Icon = reasonIcons[i] ?? Cog;
      return (
        <li class="self-hosted-reason">
          <span class="self-hosted-reason__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="self-hosted-reason__icon" aria-hidden="true">
            <Icon size={22} strokeWidth={1.75} />
          </div>
          <h3 class="self-hosted-reason__title">{reason.title}</h3>
          <p class="self-hosted-reason__desc text-body text-ink">{reason.desc}</p>
        </li>
      );
    })}
  </ol>
</Section>

<Section surface="tint" padding="lg" class="mt-8 lg:mt-16" id="under-the-hood">
  <header class="max-w-[760px] mb-12 flex flex-col gap-4">
    <h2 class="text-h1 font-display font-bold text-ink">
      {t('selfHosted.underTheHood.summary')}
    </h2>
    <p class="text-body text-ink-soft">
      {t('selfHosted.underTheHood.intro')}
    </p>
  </header>

  <div class="flex flex-col gap-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] gap-10 items-center">
      <div class="flex flex-col gap-4">
        <h3 class="text-h3 font-bold text-ink">
          {t('selfHosted.underTheHood.controlData.title')}
        </h3>
        {controlDataParas.map((para) => (
          <p class="text-body text-ink">{para}</p>
        ))}
      </div>
      <ControlDataPlanes />
    </div>

    <div class="max-w-[760px]">
      <h3 class="text-h3 font-bold text-ink mb-3">
        {t('selfHosted.underTheHood.sourceVisible.title')}
      </h3>
      <p class="text-body text-ink">
        {t('selfHosted.underTheHood.sourceVisible.body')}
      </p>
    </div>
  </div>
</Section>

<style>
  .self-hosted-update__label {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--sky-action);
    color: #ffffff;
  }
  .self-hosted-reasons {
    counter-reset: reason;
    position: relative;
  }
  .self-hosted-reason {
    position: relative;
    padding: 8px 28px 8px 24px;
    border-left: 1px solid color-mix(in srgb, var(--sky-action) 22%, transparent);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .self-hosted-reason::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    width: 1px;
    height: 36px;
    background: var(--sky-action);
  }
  .self-hosted-reason:nth-child(2)::before { height: 50%; }
  .self-hosted-reason:nth-child(3)::before { height: 100%; }
  .self-hosted-reason__num {
    position: absolute;
    right: 8px;
    top: -18px;
    font-family: var(--font-display, ui-sans-serif, system-ui);
    font-size: 88px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--sky-action) 14%, transparent);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .self-hosted-reason__icon {
    position: relative;
    z-index: 1;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--sky-action);
    background: color-mix(in srgb, var(--sky-action) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--sky-action) 22%, transparent);
  }
  .self-hosted-reason__title {
    position: relative;
    z-index: 1;
    font-family: var(--font-display, inherit);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.25;
    color: var(--ink);
  }
  .self-hosted-reason__desc {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 767px) {
    .self-hosted-reason__num { font-size: 72px; top: -12px; }
  }
</style>
