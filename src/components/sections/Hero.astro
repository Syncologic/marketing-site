---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  eyebrowAsBadge?: boolean;
  headline: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  surface?: 'sky' | 'pane' | 'tint';
  id?: string;
}

const {
  eyebrow,
  eyebrowAsBadge = false,
  headline,
  subheading,
  primaryCta,
  surface = 'sky',
  id,
} = Astro.props;

const hasVisual = Astro.slots.has('visual');
const gridClass = hasVisual
  ? 'grid grid-cols-1 lg:grid-cols-[minmax(0,560px)_minmax(0,1fr)] xl:grid-cols-[minmax(0,760px)_minmax(0,1fr)] gap-12 items-center'
  : 'grid grid-cols-1 gap-12 items-center';
---

<Section surface={surface} padding="lg" id={id}>
  <div class={gridClass}>
    <div class="flex flex-col gap-6 hero-fade-in">
      {Astro.slots.has('banner') && (
        <div class="hero-banner self-start lg:self-start"><slot name="banner" /></div>
      )}
      {eyebrow && (
        eyebrowAsBadge ? (
          <span class="hero-eyebrow-badge self-start">
            {eyebrow}
          </span>
        ) : (
          <span class="text-caption font-medium uppercase tracking-wide text-ink-soft">
            {eyebrow}
          </span>
        )
      )}
      <h1 class="text-h1 md:text-display-2 lg:text-display-1 font-display font-bold tracking-tight text-ink">
        {headline}
      </h1>
      {subheading && (
        <p class="text-body text-ink max-w-[640px]">{subheading}</p>
      )}
      {(Astro.slots.has('cta') || primaryCta) && (
        <div class="flex flex-wrap gap-3 mt-2 justify-center lg:justify-start">
          {Astro.slots.has('cta') ? (
            <slot name="cta" />
          ) : (
            <Button href={primaryCta!.href} variant="primary" size="lg" class="text-center whitespace-normal break-words max-w-full">{primaryCta!.label}</Button>
          )}
        </div>
      )}
      <slot name="meta" />
    </div>
    {hasVisual && (
      <div class="hero-fade-in" style="animation-delay: 120ms;">
        <slot name="visual" />
      </div>
    )}
  </div>
</Section>

<style>
  .hero-eyebrow-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    color: #ffffff;
    background: var(--sky-action);
  }
</style>
