---
import Button from '../ui/Button.astro';
import ProviderLogo from '../ui/ProviderLogo.astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);

const providerIconMap: Array<{ value: string; logoId: 'google-drive' | 'onedrive' | 's3' | 'your_server' | 'dropbox' }> = [
  { value: 'google_drive', logoId: 'google-drive' },
  { value: 'onedrive', logoId: 'onedrive' },
  { value: 'dropbox', logoId: 'dropbox' },
  { value: 's3', logoId: 's3' },
  { value: 'your_server', logoId: 'your_server' },
];
---

<div
  class="waitlist-modal hidden fixed inset-0 z-[80]"
  data-locale={locale}
  aria-hidden="true"
>
  <div class="waitlist-modal-backdrop absolute inset-0 bg-[rgb(8_14_30/0.7)] opacity-0 transition-opacity duration-300"></div>

  <div class="absolute inset-0 flex items-stretch sm:items-center justify-center sm:p-6 overflow-y-auto">
    <div
      class="waitlist-modal-panel relative w-full sm:max-w-xl sm:!rounded-card flex flex-col max-h-[100dvh] sm:h-[500px] sm:max-h-[calc(100dvh-3rem)] opacity-0 translate-y-3 transition-all duration-400 focus:outline-none focus-visible:outline-none"
      role="dialog"
      aria-modal="true"
      aria-labelledby="waitlist-modal-title"
      tabindex="-1"
      data-squircle
      data-squircle-radius="24"
    >
      <button
        type="button"
        class="waitlist-modal-nav waitlist-modal-back absolute top-4 left-4"
        style="display: none"
        aria-label={t('waitlist.back')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12,19 5,12 12,5" />
        </svg>
      </button>

      <button
        type="button"
        class="waitlist-modal-nav waitlist-modal-close absolute top-4 right-4"
        aria-label={t('nav.close')}
      >
        <svg class="waitlist-modal-close-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>

      <div class="waitlist-modal-intro px-6 sm:px-10 py-6 sm:py-8 text-center flex flex-col items-center justify-center grow">
        <div class="waitlist-modal-logo inline-flex items-center justify-center mb-4">
          <img
            src="/assets/brand/icon_white_background.svg"
            alt=""
            width="88"
            height="88"
            class="w-20 h-20 sm:w-22 sm:h-22"
          />
        </div>
        <p class="waitlist-modal-greeting text-compact font-medium text-ink-soft mb-2 tracking-wide">
          {t('homepage.modal.greeting')}
        </p>
        <h2
          id="waitlist-modal-title"
          class="waitlist-modal-title sr-only"
        >
          {t('homepage.modal.title')}
        </h2>
        <p class="waitlist-modal-intro-body text-body text-ink mt-3 max-w-md leading-snug">
          {t('homepage.modal.intro')}
        </p>
        <div class="waitlist-modal-intro-actions flex flex-col items-center gap-2 mt-5">
          <Button type="button" variant="primary" size="lg" class="waitlist-modal-cta">
            {t('homepage.modal.cta')}
          </Button>
          <button
            type="button"
            class="waitlist-modal-skip text-caption text-ink-soft hover:text-ink underline transition-colors"
          >
            {t('homepage.modal.skipIntro')}
          </button>
        </div>
      </div>

      <div
        class="waitlist-step2 hidden px-6 sm:px-8 pt-8 sm:pt-10 pb-6 sm:pb-8 flex-col grow min-h-0"
        data-row-id=""
        data-token=""
        data-segment-hint=""
        data-msg-q-use-case={t('waitlist.questionUseCase')}
        data-msg-q-source-provider={t('waitlist.questionSourceProvider')}
        data-msg-q-dest-provider={t('waitlist.questionDestProvider')}
        data-msg-q-size={t('waitlist.questionSize')}
        data-msg-q-frequency={t('waitlist.questionFrequency')}
        data-msg-q-runner={t('waitlist.questionRunner')}
        data-msg-q-role={t('waitlist.questionRole')}
        data-msg-hint-auto={t('waitlist.hintAutoAdvance')}
        data-msg-hint-last={t('waitlist.hintLastStep')}
        data-msg-encourage-first={t('waitlist.encourageFirst')}
        data-msg-encourage-mid={t('waitlist.encourageMid')}
        data-msg-encourage-last={t('waitlist.encourageLast')}
        data-msg-done={t('waitlist.done')}
        data-msg-done-sub={t('waitlist.doneSub')}
        data-msg-next={t('waitlist.next')}
        data-msg-back={t('waitlist.back')}
        data-msg-close={t('waitlist.close')}
      >
        <div class="shrink-0">
          <div class="step2-progress flex justify-center items-center gap-1.5 mb-3" role="tablist" aria-label="Question steps"></div>
          <p class="step2-progress-label text-caption text-ink-soft text-center mb-4" role="status" aria-live="polite"></p>
          <div class="step2-anim transition-all duration-300 ease-out">
            <p class="step2-eyebrow text-compact font-medium text-ink text-center mb-2 min-h-[1.5rem]"></p>
            <h3 class="step2-title text-h3 font-bold text-ink text-center"></h3>
          </div>
        </div>

        <div class="grow flex items-center justify-center min-h-0 py-4">
          <div class="step2-anim transition-all duration-300 ease-out w-full">
            <div class="step2-options grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
          </div>
        </div>

        <p class="step2-hint hidden sm:block text-small text-ink-soft text-center min-h-[1.25rem] shrink-0"></p>
      </div>
    </div>
  </div>

  <template class="step2-icon-template">
    {providerIconMap.map((p) => (
      <div data-id={p.value}>
        <ProviderLogo provider={p.logoId} size={24} />
      </div>
    ))}
  </template>
</div>

<script>
  import { loadWaitlistState, saveWaitlistState, clearWaitlistState } from '../../lib/waitlist-storage';

  type Locale = 'en' | 'pt-br';

  const QUESTIONS: Array<{ field: string; options: Array<{ value: string; label: { en: string; 'pt-br': string } }> }> = [
    {
      field: 'use_case',
      options: [
        { value: 'one_time_transfer', label: { en: 'One-time transfer', 'pt-br': 'Transferência única' } },
        { value: 'business_migration', label: { en: 'Business migration', 'pt-br': 'Migração de empresa' } },
        { value: 'scheduled_backup', label: { en: 'Scheduled backup', 'pt-br': 'Backup agendado' } },
        { value: 'local_backup', label: { en: 'Local / NAS backup', 'pt-br': 'Backup local / NAS' } },
        { value: 'developer', label: { en: 'API / automation', 'pt-br': 'API / automação' } },
        { value: 'self_hosted', label: { en: 'Self-hosting', 'pt-br': 'Auto-hospedagem' } },
      ],
    },
    {
      field: 'source_provider',
      options: [
        { value: 'google_drive', label: { en: 'Google Drive', 'pt-br': 'Google Drive' } },
        { value: 'onedrive', label: { en: 'OneDrive', 'pt-br': 'OneDrive' } },
        { value: 'dropbox', label: { en: 'Dropbox', 'pt-br': 'Dropbox' } },
        { value: 's3', label: { en: 'S3 / S3-compatible', 'pt-br': 'S3 / compatível com S3' } },
        { value: 'your_server', label: { en: 'My server', 'pt-br': 'Meu servidor' } },
        { value: 'other', label: { en: 'Other', 'pt-br': 'Outro' } },
      ],
    },
    {
      field: 'dest_provider',
      options: [
        { value: 'google_drive', label: { en: 'Google Drive', 'pt-br': 'Google Drive' } },
        { value: 'onedrive', label: { en: 'OneDrive', 'pt-br': 'OneDrive' } },
        { value: 'dropbox', label: { en: 'Dropbox', 'pt-br': 'Dropbox' } },
        { value: 's3', label: { en: 'S3 / S3-compatible', 'pt-br': 'S3 / compatível com S3' } },
        { value: 'your_server', label: { en: 'My server', 'pt-br': 'Meu servidor' } },
        { value: 'other', label: { en: 'Other', 'pt-br': 'Outro' } },
      ],
    },
    {
      field: 'est_size',
      options: [
        { value: 'lt_10gb', label: { en: 'Less than 10 GB', 'pt-br': 'Menos de 10 GB' } },
        { value: '10_to_100gb', label: { en: '10–100 GB', 'pt-br': '10–100 GB' } },
        { value: '100gb_to_1tb', label: { en: '100 GB – 1 TB', 'pt-br': '100 GB – 1 TB' } },
        { value: 'gt_1tb', label: { en: 'More than 1 TB', 'pt-br': 'Mais de 1 TB' } },
      ],
    },
    {
      field: 'frequency',
      options: [
        { value: 'one_time', label: { en: 'One time', 'pt-br': 'Uma vez' } },
        { value: 'weekly', label: { en: 'Weekly', 'pt-br': 'Semanalmente' } },
        { value: 'daily', label: { en: 'Daily', 'pt-br': 'Diariamente' } },
        { value: 'continuous', label: { en: 'Continuous sync', 'pt-br': 'Sincronização contínua' } },
      ],
    },
    {
      field: 'preferred_runner',
      options: [
        { value: 'cloud', label: { en: 'Syncologic cloud', 'pt-br': 'Nuvem da Syncologic' } },
        { value: 'browser', label: { en: 'My browser', 'pt-br': 'Meu navegador' } },
        { value: 'private', label: { en: 'My own server / NAS', 'pt-br': 'Meu próprio servidor / NAS' } },
        { value: 'not_sure', label: { en: 'Not sure yet', 'pt-br': 'Ainda não sei' } },
      ],
    },
    {
      field: 'role',
      options: [
        { value: 'consumer', label: { en: 'Personal user', 'pt-br': 'Usuário pessoal' } },
        { value: 'business', label: { en: 'Small business / founder', 'pt-br': 'Pequena empresa / fundador' } },
        { value: 'it', label: { en: 'IT / sysadmin', 'pt-br': 'TI / sysadmin' } },
        { value: 'developer', label: { en: 'Developer', 'pt-br': 'Desenvolvedor' } },
        { value: 'homelab', label: { en: 'Homelab / hobbyist', 'pt-br': 'Homelab / hobbyista' } },
      ],
    },
  ];

  const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const TOKEN_RE = /^[0-9a-f]{64}$/i;

  const modalState = { answered: 0, total: 0, complete: false, hint: null as string | null };

  const modalEl = document.querySelector<HTMLElement>('.waitlist-modal');
  if (modalEl) {
    const modal = modalEl;
    const backdrop = modal.querySelector<HTMLElement>('.waitlist-modal-backdrop')!;
    const panel = modal.querySelector<HTMLElement>('.waitlist-modal-panel')!;
    const intro = modal.querySelector<HTMLElement>('.waitlist-modal-intro')!;
    const step2 = modal.querySelector<HTMLElement>('.waitlist-step2')!;
    const backBtn = modal.querySelector<HTMLButtonElement>('.waitlist-modal-back')!;
    let activeBackHandler: ((e: Event) => void) | null = null;
    function setBackHandler(fn: (e: Event) => void) {
      if (activeBackHandler) backBtn.removeEventListener('click', activeBackHandler);
      activeBackHandler = fn;
      backBtn.addEventListener('click', fn);
    }
    const introCta = modal.querySelector<HTMLButtonElement>('.waitlist-modal-cta')!;
    const introSkip = modal.querySelector<HTMLButtonElement>('.waitlist-modal-skip')!;
    const closeBtn = modal.querySelector<HTMLButtonElement>('.waitlist-modal-close')!;
    const pageLocale = (modal.dataset.locale ?? 'en') as Locale;
    const step2Template = step2.innerHTML;
    let step2Rendered = false;
    function restoreStep2Scaffold() {
      step2.innerHTML = step2Template;
    }

    let lastView: 'intro' | 'step2' = 'intro';

    function showIntro() {
      intro.classList.remove('hidden');
      intro.style.opacity = '';
      intro.style.transform = '';
      step2.classList.add('hidden');
      step2.classList.remove('flex');
      backBtn.style.display = 'none';
      lastView = 'intro';
    }

    function showStep2() {
      intro.classList.add('hidden');
      intro.style.opacity = '';
      intro.style.transform = '';
      step2.classList.remove('hidden');
      step2.classList.add('flex');
      backBtn.style.display = '';
      lastView = 'step2';
    }

    function resetToIntro() {
      showIntro();
      step2Rendered = false;
    }

    function advanceToQuestions() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveal = () => {
        showStep2();
        if (!step2Rendered) {
          renderStep2(step2, pageLocale);
          step2Rendered = true;
        }
      };
      if (reduceMotion) {
        reveal();
        return;
      }
      intro.style.transition = 'opacity 220ms ease-out, transform 220ms ease-out';
      intro.style.opacity = '0';
      intro.style.transform = 'translateY(-4px)';
      window.setTimeout(reveal, 220);
    }

    introCta.addEventListener('click', advanceToQuestions);

    let lastFocus: HTMLElement | null = null;
    let bodyLocked = false;
    function lockScroll() {
      if (bodyLocked) return;
      document.documentElement.style.overflow = 'hidden';
      bodyLocked = true;
    }
    function unlockScroll() {
      if (!bodyLocked) return;
      document.documentElement.style.overflow = '';
      bodyLocked = false;
    }

    function openModal(id: string, token: string) {
      const saved = loadWaitlistState();
      const resume = saved && saved.id === id && saved.token === token ? saved : null;
      if (saved && !resume) clearWaitlistState();

      step2.dataset.rowId = id;
      step2.dataset.token = token;
      modalState.hint = step2.dataset.segmentHint || null;
      modalState.answered = resume?.answered ?? 0;
      modalState.total = resume?.total ?? 0;
      modalState.complete = resume?.complete ?? false;
      saveWaitlistState({
        id,
        token,
        answers: resume?.answers ?? {},
        cursor: resume?.cursor ?? 0,
        complete: resume?.complete ?? false,
        answered: resume?.answered ?? 0,
        total: resume?.total ?? 0,
        lastView: resume?.lastView ?? 'intro',
      });

      if (resume && (resume.lastView === 'step2' || resume.complete)) {
        restoreStep2Scaffold();
        showStep2();
        renderStep2(step2, pageLocale, resume);
        step2Rendered = true;
      } else {
        restoreStep2Scaffold();
        showIntro();
        step2Rendered = false;
      }
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      lockScroll();
      lastFocus = document.activeElement as HTMLElement | null;
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        panel.classList.remove('opacity-0', 'translate-y-3');
      });
      panel.focus({ preventScroll: true });
    }

    function closeModal() {
      backdrop.classList.add('opacity-0');
      panel.classList.add('opacity-0', 'translate-y-3');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finish = () => {
        modal.classList.add('hidden');
        modal.setAttribute('aria-hidden', 'true');
        unlockScroll();
        lastFocus?.focus?.({ preventScroll: true });
        saveWaitlistState({
          lastView,
          answered: modalState.answered,
          total: modalState.total,
          complete: modalState.complete,
        });
        window.dispatchEvent(
          new CustomEvent('waitlist:closed', {
            detail: {
              id: step2.dataset.rowId,
              token: step2.dataset.token,
              answered: modalState.answered,
              total: modalState.total,
              complete: modalState.complete,
            },
          }),
        );
      };
      if (reduceMotion) {
        finish();
      } else {
        window.setTimeout(finish, 280);
      }
    }

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    window.addEventListener('waitlist:completed', () => {
      backBtn.style.display = 'none';
    });
    window.addEventListener('waitlist:request-close', () => {
      if (!modal.classList.contains('hidden')) closeModal();
    });
    introSkip.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    type WaitlistModalDetail = { id: string; token: string };
    interface WaitlistModalApi {
      open(detail: WaitlistModalDetail): void;
    }
    (window as unknown as { openWaitlistModal: WaitlistModalApi['open'] }).openWaitlistModal = ({ id, token }) => {
      if (!UUID_RE.test(id) || !TOKEN_RE.test(token)) return;
      openModal(id, token);
    };

    const params = new URLSearchParams(window.location.search);
    const wlId = params.get('wl_id');
    const wlToken = params.get('wl_t');
    if (wlId && wlToken && UUID_RE.test(wlId) && TOKEN_RE.test(wlToken)) {
      openModal(wlId, wlToken);
      const url = new URL(window.location.href);
      url.searchParams.delete('wl_id');
      url.searchParams.delete('wl_t');
      window.history.replaceState({}, '', url.toString());
    }

  interface Step2Seed {
    answers?: Record<string, string>;
    cursor?: number;
    complete?: boolean;
  }

  function renderStep2(step2: HTMLElement, locale: Locale, seed: Step2Seed = {}) {
    const id = step2.dataset.rowId!;
    const token = step2.dataset.token!;
    const hint = step2.dataset.segmentHint || null;

    const step2Msgs = {
      questionByField: {
        use_case: step2.dataset.msgQUseCase ?? '',
        source_provider: step2.dataset.msgQSourceProvider ?? '',
        dest_provider: step2.dataset.msgQDestProvider ?? '',
        est_size: step2.dataset.msgQSize ?? '',
        frequency: step2.dataset.msgQFrequency ?? '',
        preferred_runner: step2.dataset.msgQRunner ?? '',
        role: step2.dataset.msgQRole ?? '',
      } as Record<string, string>,
      hintAutoAdvance: step2.dataset.msgHintAuto ?? '',
      hintLastStep: step2.dataset.msgHintLast ?? '',
      encourageFirst: step2.dataset.msgEncourageFirst ?? '',
      encourageMid: step2.dataset.msgEncourageMid ?? '',
      encourageLast: step2.dataset.msgEncourageLast ?? '',
      done: step2.dataset.msgDone ?? '',
      doneSub: step2.dataset.msgDoneSub ?? '',
      next: step2.dataset.msgNext ?? '',
      back: step2.dataset.msgBack ?? '',
      close: step2.dataset.msgClose ?? '',
    };

    const progress = step2.querySelector<HTMLElement>('.step2-progress')!;
    const progressLabel = step2.querySelector<HTMLElement>('.step2-progress-label')!;
    const animEls = Array.from(step2.querySelectorAll<HTMLElement>('.step2-anim'));
    const eyebrowEl = step2.querySelector<HTMLElement>('.step2-eyebrow')!;
    const titleEl = step2.querySelector<HTMLElement>('.step2-title')!;
    const optionsEl = step2.querySelector<HTMLElement>('.step2-options')!;
    const hintEl = step2.querySelector<HTMLElement>('.step2-hint')!;
    // backBtn + setBackHandler are bound in the outer scope

    const iconTpl = document.querySelector<HTMLTemplateElement>('.step2-icon-template')!;
    function getProviderIcon(value: string): SVGElement | null {
      const wrapper = iconTpl.content.querySelector<HTMLElement>(`div[data-id="${value}"]`);
      const svg = wrapper?.querySelector('svg');
      return svg ? (svg.cloneNode(true) as SVGElement) : null;
    }
    const PROVIDER_FIELDS = new Set(['source_provider', 'dest_provider']);

    const answers: Record<string, string | undefined> = { ...(seed.answers ?? {}) };
    if (hint && !answers.use_case) answers.use_case = hint;
    modalState.total = QUESTIONS.length;
    modalState.answered = Object.keys(answers).filter((k) => k !== 'use_case' || !modalState.hint).length;

    let cursor = Math.min(Math.max(seed.cursor ?? 0, 0), QUESTIONS.length - 1);
    let pendingAdvance: number | null = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    progress.innerHTML = '';
    QUESTIONS.forEach((q, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', `Question ${i + 1}: ${step2Msgs.questionByField[q.field]}`);
      dot.className = 'h-1.5 w-6 rounded-pill bg-[color-mix(in_srgb,var(--ink)_15%,transparent)] transition-all duration-300 cursor-pointer hover:bg-[color-mix(in_srgb,var(--ink)_30%,transparent)]';
      dot.addEventListener('click', () => goTo(i));
      progress.appendChild(dot);
    });

    function paintProgress() {
      progress.querySelectorAll<HTMLButtonElement>('button').forEach((dot, i) => {
        const base = 'h-1.5 rounded-pill transition-all duration-300 cursor-pointer ';
        if (i < cursor) {
          dot.className = base + 'w-6 bg-[var(--sky-action)] hover:bg-[var(--sky-action-hover)]';
          dot.setAttribute('aria-current', 'false');
        } else if (i === cursor) {
          dot.className = base + 'w-10 bg-[var(--sky-action)]';
          dot.setAttribute('aria-current', 'step');
        } else {
          dot.className = base + 'w-6 bg-[color-mix(in_srgb,var(--ink)_15%,transparent)] hover:bg-[color-mix(in_srgb,var(--ink)_30%,transparent)]';
          dot.setAttribute('aria-current', 'false');
        }
      });
    }

    function buildOption(q: typeof QUESTIONS[number], opt: typeof q.options[number], idx: number): HTMLButtonElement {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.field = q.field;
      btn.dataset.value = opt.value;
      btn.style.transitionDelay = reduceMotion ? '0ms' : `${idx * 25}ms`;
      btn.className =
        'waitlist-option group flex items-center gap-3 w-full px-4 py-3 text-caption font-medium text-left text-ink rounded-input transition-all duration-200';

      if (PROVIDER_FIELDS.has(q.field)) {
        const iconSlot = document.createElement('span');
        iconSlot.className = 'flex-shrink-0 w-6 h-6 grid place-items-center';
        const ic = getProviderIcon(opt.value);
        if (ic) iconSlot.appendChild(ic);
        btn.appendChild(iconSlot);
      }

      const label = document.createElement('span');
      label.className = 'flex-1';
      label.textContent = opt.label[locale];
      btn.appendChild(label);

      const check = document.createElement('span');
      check.className = 'hidden group-data-[selected=true]:grid place-items-center w-5 h-5 rounded-pill bg-white text-[var(--sky-action)] text-small font-bold flex-shrink-0';
      check.setAttribute('aria-hidden', 'true');
      check.textContent = '✓';
      btn.appendChild(check);

      if (answers[q.field] === opt.value) btn.dataset.selected = 'true';
      btn.addEventListener('click', () => onPick(q.field, opt.value));
      return btn;
    }

    function paintQuestion() {
      const q = QUESTIONS[cursor];
      const isFirst = cursor === 0;
      const isLast = cursor === QUESTIONS.length - 1;
      progressLabel.textContent = `${cursor + 1} / ${QUESTIONS.length}`;
      eyebrowEl.textContent = isFirst
        ? step2Msgs.encourageFirst
        : isLast
        ? step2Msgs.encourageLast
        : step2Msgs.encourageMid;
      titleEl.textContent = step2Msgs.questionByField[q.field];
      hintEl.textContent = isLast
        ? step2Msgs.hintLastStep
        : step2Msgs.hintAutoAdvance;

      optionsEl.innerHTML = '';
      q.options.forEach((opt, idx) => {
        optionsEl.appendChild(buildOption(q, opt, idx));
      });

      paintProgress();
    }

    setBackHandler(() => {
      if (cursor > 0) {
        goTo(cursor - 1);
        return;
      }
      showIntro();
    });

    function transitionTo(direction: 1 | -1, render: () => void) {
      if (reduceMotion) {
        render();
        return;
      }
      const offset = direction === 1 ? '-translate-x-3' : 'translate-x-3';
      animEls.forEach((el) => el.classList.add('opacity-0', offset));
      window.setTimeout(() => {
        render();
        animEls.forEach((el) => {
          el.classList.add(direction === 1 ? 'translate-x-3' : '-translate-x-3');
          el.classList.remove(offset);
        });
        requestAnimationFrame(() => {
          animEls.forEach((el) => el.classList.remove('opacity-0', 'translate-x-3', '-translate-x-3'));
        });
      }, 180);
    }

    function goTo(target: number) {
      if (target === cursor) return;
      if (pendingAdvance !== null) {
        clearTimeout(pendingAdvance);
        pendingAdvance = null;
      }
      const dir: 1 | -1 = target > cursor ? 1 : -1;
      cursor = target;
      transitionTo(dir, paintQuestion);
    }

    function onPick(field: string, value: string) {
      answers[field] = value;
      modalState.answered = Object.keys(answers).filter((k) => k !== 'use_case' || !modalState.hint).length;
      optionsEl.querySelectorAll<HTMLButtonElement>('button[data-field]').forEach((b) => {
        b.dataset.selected = b.dataset.value === value ? 'true' : 'false';
      });
      patch({ [field]: value });
      persist();
      if (pendingAdvance !== null) clearTimeout(pendingAdvance);
      const isLastNow = cursor === QUESTIONS.length - 1;
      if (isLastNow) {
        modalState.complete = true;
        pendingAdvance = window.setTimeout(() => {
          pendingAdvance = null;
          complete();
        }, 380);
        return;
      }
      pendingAdvance = window.setTimeout(() => {
        pendingAdvance = null;
        if (cursor < QUESTIONS.length - 1) goTo(cursor + 1);
      }, 380);
    }

    function persist() {
      const cleanAnswers: Record<string, string> = {};
      for (const [k, v] of Object.entries(answers)) if (typeof v === 'string') cleanAnswers[k] = v;
      saveWaitlistState({
        id,
        token,
        answers: cleanAnswers,
        cursor,
        complete: modalState.complete,
        answered: modalState.answered,
        total: modalState.total,
        lastView: 'step2',
      });
    }

    async function patch(body: Record<string, unknown>) {
      try {
        await fetch(`/api/waitlist/${id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json', 'x-waitlist-token': token },
          body: JSON.stringify(body),
        });
      } catch {}
    }

    function renderThanks() {
      step2.innerHTML = `
        <div class="step2-thanks flex flex-col items-center justify-center text-center gap-4 py-8 h-full">
          <svg class="step2-checkmark text-success" width="72" height="72" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle class="step2-check-circle" cx="32" cy="32" r="29" stroke="currentColor" stroke-width="3" fill="none"></circle>
            <polyline class="step2-check-tick" points="20,33 28,42 46,22" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></polyline>
          </svg>
          <p class="step2-thanks-msg text-h2 font-medium text-ink">${step2Msgs.done}</p>
          <p class="step2-thanks-sub text-body text-ink">${step2Msgs.doneSub}</p>
          <button type="button" class="step2-thanks-close btn-primary-glass mt-4 px-[26px] py-[14px] text-[16px] font-semibold">${step2Msgs.close}</button>
        </div>
      `;
      const triggerClose = () => window.dispatchEvent(new CustomEvent('waitlist:request-close'));
      step2.querySelector<HTMLButtonElement>('.step2-thanks-close')
        ?.addEventListener('click', triggerClose);
    }

    async function complete() {
      modalState.complete = true;
      persist();
      await patch({ ...answers, _complete: true });
      window.dispatchEvent(new CustomEvent('waitlist:completed'));
      renderThanks();
    }

    if (seed.complete) {
      modalState.complete = true;
      renderThanks();
      return;
    }

    paintQuestion();
  }
  }
</script>

