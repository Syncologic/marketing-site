---
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
import ProviderLogo from '../ui/ProviderLogo.astro';
import { getLocaleFromUrl, getT } from '../../i18n/utils';
import type { WaitlistPost } from '../../lib/validation';

interface Props {
  segmentHint?: WaitlistPost['segment_hint'];
  id?: string;
}

const { segmentHint = null, id = 'waitlist' } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
const sourcePage = Astro.url.pathname;

const providerIconMap: Array<{ value: string; logoId: 'google-drive' | 'onedrive' | 'dropbox' | 's3' | 'sftp' | 'webdav' | 'nextcloud' }> = [
  { value: 'google_drive', logoId: 'google-drive' },
  { value: 'onedrive', logoId: 'onedrive' },
  { value: 'dropbox', logoId: 'dropbox' },
  { value: 's3', logoId: 's3' },
  { value: 'sftp', logoId: 'sftp' },
  { value: 'webdav', logoId: 'webdav' },
  { value: 'nextcloud', logoId: 'nextcloud' },
];
---

<section id={id} data-locale={locale} class="bg-white py-section">
  <div class="container-wide max-w-2xl text-center">
    <h2 class="text-h1 font-medium text-dark-charcoal mb-4">{t('nav.joinWaitlist')}</h2>
    <p class="text-body text-slate-gray mb-8 max-w-xl mx-auto">{t('waitlist.step1Subtitle')}</p>

    <form
      class="waitlist-form-step1 flex flex-col sm:flex-row gap-3 justify-center"
      data-source-page={sourcePage}
      data-locale={locale}
      data-segment-hint={segmentHint}
      novalidate
    >
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <Input type="email" name="email" required placeholder={t('waitlist.emailPlaceholder')} ariaLabel={t('waitlist.emailLabel')} class="sm:max-w-xs" />
      <Button type="submit" variant="primary">
        <span class="btn-label-default">{t('waitlist.submit')}</span>
        <span class="btn-label-loading hidden">{t('waitlist.submitting')}</span>
      </Button>
    </form>
    <p
      class="waitlist-msg mt-3 text-caption text-slate-gray min-h-[20px]"
      role="status"
      aria-live="polite"
      data-msg-success={t('waitlist.success')}
      data-msg-error-network={t('waitlist.errorNetwork')}
      data-msg-error-rate={t('waitlist.errorRate')}
    ></p>

    <div class="waitlist-step2 hidden bg-soft-gray text-left flex flex-col fixed inset-0 z-[60] mt-0 mx-0 max-w-none rounded-none px-6 pt-4 pb-6 overflow-hidden sm:relative sm:inset-auto sm:z-auto sm:mt-10 sm:mx-auto sm:max-w-xl sm:rounded-card sm:p-8 sm:overflow-visible" data-row-id="" data-token="" data-segment-hint={segmentHint ?? ''}>
      <div class="flex justify-end mb-1 shrink-0 sm:hidden">
        <button type="button" class="step2-close w-11 h-11 shrink-0 -mr-2 inline-flex items-center justify-center text-slate-gray hover:text-dark-charcoal" aria-label={t('nav.close')}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
      </div>
      <div class="step2-progress flex justify-center items-center gap-1.5 mb-3 shrink-0" role="tablist" aria-label="Question steps"></div>
      <p class="step2-progress-label hidden sm:block text-caption text-slate-gray text-center mb-6" role="status" aria-live="polite"></p>

      <div class="step2-stage relative overflow-hidden grow shrink min-h-0 flex flex-col">
        <div class="step2-card transition-all duration-300 ease-out flex flex-col h-full min-h-0">
          <p class="step2-eyebrow text-compact font-medium text-dark-charcoal text-center mb-3 min-h-[1.5rem] shrink-0"></p>
          <h3 class="step2-title text-h3 font-bold text-dark-charcoal text-center mb-4 sm:mb-6 shrink-0"></h3>
          <div class="step2-options grid grid-cols-1 sm:grid-cols-2 gap-2 grow min-h-0 overflow-y-auto sm:grow-0 sm:overflow-visible"></div>
        </div>
      </div>

      <p class="step2-hint hidden sm:block text-small text-slate-gray text-center mt-5 min-h-[1.25rem]"></p>

      <div class="step2-controls hidden sm:flex items-center justify-between gap-3 mt-6 shrink-0">
        <button type="button" class="step2-back text-caption text-slate-gray hover:text-dark-charcoal underline disabled:opacity-30 disabled:no-underline disabled:hover:text-slate-gray transition-colors" disabled>← Back</button>
        <button type="button" class="step2-skip text-caption text-slate-gray hover:text-dark-charcoal underline transition-colors">{t('waitlist.step2Skip')}</button>
        <Button type="button" variant="primary" size="sm" class="step2-next">Next →</Button>
      </div>
    </div>

    <template class="step2-icon-template">
      {providerIconMap.map((p) => (
        <div data-id={p.value}>
          <ProviderLogo provider={p.logoId} size={24} />
        </div>
      ))}
    </template>
  </div>
</section>

<script>
  type Locale = 'en' | 'pt-br';
  type Stage1Result = { id: string; token: string; status: 'created' | 'existed' };

  const I18N = {
    en: {
      success: "✓ You're on the list",
      errorNetwork: "Couldn't reach the server. Try again?",
      errorRate: "Slow down — try again in a minute.",
      questionUseCase: 'What would you like to do?',
      questionSourceProvider: 'Where do the files live now?',
      questionDestProvider: 'Where do they need to go?',
      questionSize: 'How much data?',
      questionFrequency: 'How often?',
      questionRunner: 'Where should the transfer run?',
      questionRole: 'Which best describes you?',
      hintAutoAdvance: 'Tap one — we go to the next question automatically.',
      hintLastStep: "Last one. Tap an option, then hit Done.",
      encourageFirst: "Welcome aboard! We'd love to know a bit about you.",
      encourageMid: 'Awesome. Tell us a bit more.',
      encourageLast: "Last one! You're almost there.",
      done: 'Thanks — that helps a lot.',
      doneSub: "We'll be in touch.",
      doneCta: 'Done',
      next: 'Next →',
      back: '← Back',
      close: 'Close',
    },
    'pt-br': {
      success: '✓ Você está na lista',
      errorNetwork: 'Não conseguimos nos conectar ao servidor. Tentar de novo?',
      errorRate: 'Calma — tente de novo em um minuto.',
      questionUseCase: 'O que você pretende fazer?',
      questionSourceProvider: 'Onde os arquivos estão hoje?',
      questionDestProvider: 'Para onde eles precisam ir?',
      questionSize: 'Quanto de dados?',
      questionFrequency: 'Com que frequência?',
      questionRunner: 'Onde a transferência deve rodar?',
      questionRole: 'O que descreve você melhor?',
      hintAutoAdvance: 'Toque uma — vamos pra próxima automaticamente.',
      hintLastStep: 'Última. Escolha uma opção e clique em Concluir.',
      encourageFirst: 'Bem-vindo! A gente quer te conhecer um pouco.',
      encourageMid: 'Boa. Conta um pouco mais.',
      encourageLast: 'Última! Quase lá.',
      done: 'Valeu — isso ajuda muito.',
      doneSub: 'A gente entra em contato.',
      doneCta: 'Concluir',
      next: 'Próxima →',
      back: '← Voltar',
      close: 'Fechar',
    },
  } as const;

  const QUESTIONS: Array<{ field: string; key: keyof typeof I18N.en; options: Array<{ value: string; label: { en: string; 'pt-br': string } }> }> = [
    {
      field: 'use_case', key: 'questionUseCase',
      options: [
        { value: 'one_time_transfer', label: { en: 'One-time transfer', 'pt-br': 'Transferência única' } },
        { value: 'business_migration', label: { en: 'Business migration', 'pt-br': 'Migração de empresa' } },
        { value: 'scheduled_backup', label: { en: 'Scheduled backup', 'pt-br': 'Backup agendado' } },
        { value: 'local_backup', label: { en: 'Local / NAS backup', 'pt-br': 'Backup local / NAS' } },
        { value: 'developer', label: { en: 'API / automation', 'pt-br': 'API / automação' } },
        { value: 'self_hosted', label: { en: 'Self-hosting', 'pt-br': 'Auto-hospedagem' } },
      ],
    },
    {
      field: 'source_provider', key: 'questionSourceProvider',
      options: [
        { value: 'google_drive', label: { en: 'Google Drive', 'pt-br': 'Google Drive' } },
        { value: 'onedrive', label: { en: 'OneDrive', 'pt-br': 'OneDrive' } },
        { value: 'dropbox', label: { en: 'Dropbox', 'pt-br': 'Dropbox' } },
        { value: 's3', label: { en: 'S3 / S3-compatible', 'pt-br': 'S3 / compatível com S3' } },
        { value: 'sftp', label: { en: 'SFTP', 'pt-br': 'SFTP' } },
        { value: 'webdav', label: { en: 'WebDAV', 'pt-br': 'WebDAV' } },
        { value: 'nextcloud', label: { en: 'Nextcloud', 'pt-br': 'Nextcloud' } },
        { value: 'other', label: { en: 'Other', 'pt-br': 'Outro' } },
      ],
    },
    {
      field: 'dest_provider', key: 'questionDestProvider',
      options: [
        { value: 'google_drive', label: { en: 'Google Drive', 'pt-br': 'Google Drive' } },
        { value: 'onedrive', label: { en: 'OneDrive', 'pt-br': 'OneDrive' } },
        { value: 'dropbox', label: { en: 'Dropbox', 'pt-br': 'Dropbox' } },
        { value: 's3', label: { en: 'S3 / S3-compatible', 'pt-br': 'S3 / compatível com S3' } },
        { value: 'sftp', label: { en: 'SFTP', 'pt-br': 'SFTP' } },
        { value: 'webdav', label: { en: 'WebDAV', 'pt-br': 'WebDAV' } },
        { value: 'nextcloud', label: { en: 'Nextcloud', 'pt-br': 'Nextcloud' } },
        { value: 'other', label: { en: 'Other', 'pt-br': 'Outro' } },
      ],
    },
    {
      field: 'est_size', key: 'questionSize',
      options: [
        { value: 'lt_10gb', label: { en: 'Less than 10 GB', 'pt-br': 'Menos de 10 GB' } },
        { value: '10_to_100gb', label: { en: '10–100 GB', 'pt-br': '10–100 GB' } },
        { value: '100gb_to_1tb', label: { en: '100 GB – 1 TB', 'pt-br': '100 GB – 1 TB' } },
        { value: 'gt_1tb', label: { en: 'More than 1 TB', 'pt-br': 'Mais de 1 TB' } },
      ],
    },
    {
      field: 'frequency', key: 'questionFrequency',
      options: [
        { value: 'one_time', label: { en: 'One time', 'pt-br': 'Uma vez' } },
        { value: 'weekly', label: { en: 'Weekly', 'pt-br': 'Semanalmente' } },
        { value: 'daily', label: { en: 'Daily', 'pt-br': 'Diariamente' } },
        { value: 'continuous', label: { en: 'Continuous sync', 'pt-br': 'Sincronização contínua' } },
      ],
    },
    {
      field: 'preferred_runner', key: 'questionRunner',
      options: [
        { value: 'cloud', label: { en: 'Syncologic cloud', 'pt-br': 'Nuvem da Syncologic' } },
        { value: 'browser', label: { en: 'My browser', 'pt-br': 'Meu navegador' } },
        { value: 'private', label: { en: 'My own server / NAS', 'pt-br': 'Meu próprio servidor / NAS' } },
        { value: 'not_sure', label: { en: 'Not sure yet', 'pt-br': 'Ainda não sei' } },
      ],
    },
    {
      field: 'role', key: 'questionRole',
      options: [
        { value: 'consumer', label: { en: 'Personal user', 'pt-br': 'Usuário pessoal' } },
        { value: 'business', label: { en: 'Small business / founder', 'pt-br': 'Pequena empresa / fundador' } },
        { value: 'it', label: { en: 'IT / sysadmin', 'pt-br': 'TI / sysadmin' } },
        { value: 'developer', label: { en: 'Developer', 'pt-br': 'Desenvolvedor' } },
        { value: 'homelab', label: { en: 'Homelab / hobbyist', 'pt-br': 'Homelab / hobbyista' } },
      ],
    },
  ];

  const FULLSCREEN_MQ = '(max-width: 639px)';
  const isMobile = () => window.matchMedia(FULLSCREEN_MQ).matches;
  let bodyScrollLocked = false;
  function lockBodyScroll() {
    if (bodyScrollLocked) return;
    document.documentElement.style.overflow = 'hidden';
    bodyScrollLocked = true;
  }
  function unlockBodyScroll() {
    if (!bodyScrollLocked) return;
    document.documentElement.style.overflow = '';
    bodyScrollLocked = false;
  }
  function openFullscreen(step2: HTMLElement) {
    if (isMobile()) lockBodyScroll();
    const closeBtn = step2.querySelector<HTMLButtonElement>('.step2-close');
    closeBtn?.addEventListener('click', () => closeFullscreen(step2), { once: true });
  }
  function closeFullscreen(step2: HTMLElement) {
    const wasMobile = isMobile();
    step2.classList.add('hidden');
    unlockBodyScroll();
    if (wasMobile) {
      const msg = step2.parentElement?.querySelector<HTMLElement>('.waitlist-msg');
      if (msg) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        requestAnimationFrame(() => {
          msg.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
        });
      }
    }
  }
  window.addEventListener('resize', () => {
    if (!isMobile()) unlockBodyScroll();
  });

  document.querySelectorAll<HTMLFormElement>('.waitlist-form-step1').forEach((form) => {
    const root = form.parentElement!;
    const msg = root.querySelector<HTMLElement>('.waitlist-msg')!;
    const step2 = root.querySelector<HTMLElement>('.waitlist-step2')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const labelDefault = submitBtn.querySelector<HTMLElement>('.btn-label-default')!;
    const labelLoading = submitBtn.querySelector<HTMLElement>('.btn-label-loading')!;
    const locale = (form.dataset.locale ?? 'en') as Locale;
    const sourcePage = form.dataset.sourcePage ?? '/';
    const segmentHint = form.dataset.segmentHint || null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') ?? '').trim();
      const honeypot = String(fd.get('website') ?? '');
      if (!email || honeypot) return;

      msg.textContent = '';
      labelDefault.classList.add('hidden');
      labelLoading.classList.remove('hidden');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, locale, source_page: sourcePage, segment_hint: segmentHint }),
        });

        if (res.status === 429) {
          msg.textContent = I18N[locale].errorRate;
          return;
        }
        if (!res.ok) {
          msg.textContent = I18N[locale].errorNetwork;
          return;
        }

        const data = (await res.json()) as Stage1Result;
        msg.textContent = I18N[locale].success;
        step2.dataset.rowId = data.id;
        step2.dataset.token = data.token;
        step2.classList.remove('hidden');
        form.classList.add('hidden');
        try {
          localStorage.setItem(`waitlist:${data.id}`, JSON.stringify({ token: data.token, email }));
        } catch {}
        renderStep2(step2, locale);
        openFullscreen(step2);

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        requestAnimationFrame(() => {
          if (!isMobile()) {
            step2.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
          }
        });
      } catch {
        msg.textContent = I18N[locale].errorNetwork;
      } finally {
        labelDefault.classList.remove('hidden');
        labelLoading.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });
  });

  function renderStep2(step2: HTMLElement, locale: Locale) {
    const id = step2.dataset.rowId!;
    const token = step2.dataset.token!;
    const hint = step2.dataset.segmentHint || null;

    const progress = step2.querySelector<HTMLElement>('.step2-progress')!;
    const progressLabel = step2.querySelector<HTMLElement>('.step2-progress-label')!;
    const stageEl = step2.querySelector<HTMLElement>('.step2-stage')!;
    const cardEl = step2.querySelector<HTMLElement>('.step2-card')!;
    const eyebrowEl = step2.querySelector<HTMLElement>('.step2-eyebrow')!;
    const titleEl = step2.querySelector<HTMLElement>('.step2-title')!;
    const optionsEl = step2.querySelector<HTMLElement>('.step2-options')!;
    const hintEl = step2.querySelector<HTMLElement>('.step2-hint')!;
    const backBtn = step2.querySelector<HTMLButtonElement>('.step2-back')!;
    const nextBtn = step2.querySelector<HTMLButtonElement>('.step2-next')!;
    const skipBtn = step2.querySelector<HTMLButtonElement>('.step2-skip')!;

    const iconTpl = document.querySelector<HTMLTemplateElement>('.step2-icon-template')!;
    function getProviderIcon(value: string): SVGElement | null {
      const wrapper = iconTpl.content.querySelector<HTMLElement>(`div[data-id="${value}"]`);
      const svg = wrapper?.querySelector('svg');
      return svg ? (svg.cloneNode(true) as SVGElement) : null;
    }
    const PROVIDER_FIELDS = new Set(['source_provider', 'dest_provider']);

    const answers: Record<string, string | undefined> = {};
    if (hint) answers.use_case = hint;

    let cursor = 0;
    let pendingAdvance: number | null = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    progress.innerHTML = '';
    QUESTIONS.forEach((q, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', `Question ${i + 1}: ${I18N[locale][q.key]}`);
      dot.className = 'h-1.5 w-6 rounded-pill bg-divider transition-all duration-300 cursor-pointer hover:bg-slate-gray';
      dot.addEventListener('click', () => goTo(i));
      progress.appendChild(dot);
    });

    function paintProgress() {
      progress.querySelectorAll<HTMLButtonElement>('button').forEach((dot, i) => {
        const base = 'h-1.5 rounded-pill transition-all duration-300 cursor-pointer ';
        if (i < cursor) {
          dot.className = base + 'w-6 bg-brand-blue hover:bg-brand-blue-hover';
          dot.setAttribute('aria-current', 'false');
        } else if (i === cursor) {
          dot.className = base + 'w-10 bg-brand-blue';
          dot.setAttribute('aria-current', 'step');
        } else {
          dot.className = base + 'w-6 bg-divider hover:bg-slate-gray';
          dot.setAttribute('aria-current', 'false');
        }
      });
    }

    function buildOption(q: typeof QUESTIONS[number], opt: typeof q.options[number], isLast: boolean, idx: number): HTMLButtonElement {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.field = q.field;
      btn.dataset.value = opt.value;
      btn.style.transitionDelay = reduceMotion ? '0ms' : `${idx * 25}ms`;
      btn.className =
        'group flex items-center gap-3 w-full px-4 py-3 text-caption font-medium text-left bg-white border border-divider rounded-input hover:border-brand-blue hover:bg-baby-blue/30 data-[selected=true]:bg-brand-blue data-[selected=true]:border-brand-blue data-[selected=true]:text-white transition-all duration-200';

      const iconSlot = document.createElement('span');
      iconSlot.className = 'flex-shrink-0 w-6 h-6 grid place-items-center';
      if (PROVIDER_FIELDS.has(q.field)) {
        const ic = getProviderIcon(opt.value);
        if (ic) {
          iconSlot.appendChild(ic);
        } else {
          const dot = document.createElement('span');
          dot.className = 'block w-2.5 h-2.5 rounded-pill bg-divider group-data-[selected=true]:bg-white/70';
          iconSlot.appendChild(dot);
        }
      } else {
        const dot = document.createElement('span');
        dot.className = 'block w-2 h-2 rounded-pill bg-divider group-hover:bg-brand-blue group-data-[selected=true]:bg-white transition-colors';
        iconSlot.appendChild(dot);
      }
      btn.appendChild(iconSlot);

      const label = document.createElement('span');
      label.className = 'flex-1';
      label.textContent = opt.label[locale];
      btn.appendChild(label);

      const check = document.createElement('span');
      check.className = 'hidden group-data-[selected=true]:grid place-items-center w-5 h-5 rounded-pill bg-white text-brand-blue text-small font-bold flex-shrink-0';
      check.setAttribute('aria-hidden', 'true');
      check.textContent = '✓';
      btn.appendChild(check);

      if (answers[q.field] === opt.value) btn.dataset.selected = 'true';
      btn.addEventListener('click', () => onPick(q.field, opt.value, isLast));
      return btn;
    }

    function paintQuestion() {
      const q = QUESTIONS[cursor];
      const isFirst = cursor === 0;
      const isLast = cursor === QUESTIONS.length - 1;
      progressLabel.textContent = `${cursor + 1} / ${QUESTIONS.length}`;
      eyebrowEl.textContent = isFirst
        ? I18N[locale].encourageFirst
        : isLast
        ? I18N[locale].encourageLast
        : I18N[locale].encourageMid;
      titleEl.textContent = I18N[locale][q.key];
      hintEl.textContent = isLast
        ? I18N[locale].hintLastStep
        : I18N[locale].hintAutoAdvance;

      optionsEl.innerHTML = '';
      q.options.forEach((opt, idx) => {
        optionsEl.appendChild(buildOption(q, opt, isLast, idx));
      });

      backBtn.disabled = cursor === 0;
      backBtn.textContent = I18N[locale].back;
      nextBtn.textContent = isLast ? I18N[locale].doneCta : I18N[locale].next;

      paintProgress();
    }

    function lockMaxHeight() {
      const startCursor = cursor;
      const savedAnswers: Record<string, string | undefined> = { ...answers };
      QUESTIONS.forEach((q) => {
        if (!answers[q.field]) answers[q.field] = q.options[0]?.value;
      });
      let max = 0;
      for (let i = 0; i < QUESTIONS.length; i++) {
        cursor = i;
        paintQuestion();
        const h = step2.offsetHeight;
        if (h > max) max = h;
      }
      Object.keys(answers).forEach((k) => delete answers[k]);
      Object.assign(answers, savedAnswers);
      cursor = startCursor;
      paintQuestion();
      step2.style.minHeight = `${max}px`;
    }

    function transitionTo(direction: 1 | -1, render: () => void) {
      if (reduceMotion) {
        render();
        return;
      }
      const offset = direction === 1 ? '-translate-x-3' : 'translate-x-3';
      cardEl.classList.add('opacity-0', offset);
      window.setTimeout(() => {
        render();
        cardEl.classList.add(direction === 1 ? 'translate-x-3' : '-translate-x-3');
        cardEl.classList.remove(offset);
        requestAnimationFrame(() => {
          cardEl.classList.remove('opacity-0', 'translate-x-3', '-translate-x-3');
        });
      }, 180);
    }

    function goTo(target: number) {
      if (target === cursor) return;
      if (pendingAdvance !== null) {
        clearTimeout(pendingAdvance);
        pendingAdvance = null;
      }
      const dir: 1 | -1 = target > cursor ? 1 : -1;
      cursor = target;
      transitionTo(dir, paintQuestion);
    }

    function onPick(field: string, value: string, isLast: boolean) {
      answers[field] = value;
      optionsEl.querySelectorAll<HTMLButtonElement>('button[data-field]').forEach((b) => {
        b.dataset.selected = b.dataset.value === value ? 'true' : 'false';
      });
      patch({ [field]: value });
      if (pendingAdvance !== null) clearTimeout(pendingAdvance);
      if (isLast) {
        if (!isMobile()) return;
        pendingAdvance = window.setTimeout(() => {
          pendingAdvance = null;
          complete();
        }, 380);
        return;
      }
      pendingAdvance = window.setTimeout(() => {
        pendingAdvance = null;
        if (cursor < QUESTIONS.length - 1) goTo(cursor + 1);
      }, 380);
    }

    backBtn.addEventListener('click', () => {
      if (cursor > 0) goTo(cursor - 1);
    });

    nextBtn.addEventListener('click', () => {
      if (cursor < QUESTIONS.length - 1) {
        goTo(cursor + 1);
      } else {
        complete();
      }
    });

    skipBtn?.addEventListener('click', complete);

    async function patch(body: Record<string, unknown>) {
      try {
        await fetch(`/api/waitlist/${id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json', 'x-waitlist-token': token },
          body: JSON.stringify(body),
        });
      } catch {}
    }

    async function complete() {
      await patch({ ...answers, _complete: true });
      step2.style.minHeight = '';
      stageEl.style.minHeight = '';
      step2.innerHTML = `
        <div class="step2-thanks flex flex-col items-center justify-center text-center gap-4 py-8 h-full">
          <svg class="step2-checkmark text-success" width="72" height="72" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle class="step2-check-circle" cx="32" cy="32" r="29" stroke="currentColor" stroke-width="3" fill="none"></circle>
            <polyline class="step2-check-tick" points="20,33 28,42 46,22" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></polyline>
          </svg>
          <p class="step2-thanks-msg text-h2 font-medium text-dark-charcoal">${I18N[locale].done}</p>
          <p class="step2-thanks-sub text-body text-slate-gray">${I18N[locale].doneSub}</p>
          <button type="button" class="step2-thanks-close mt-4 inline-flex items-center justify-center rounded-pill border-2 border-[rgba(10,19,23,0.12)] bg-transparent text-dark-charcoal hover:bg-[rgba(70,90,105,0.08)] px-6 py-2 text-caption font-medium transition-colors">${I18N[locale].close}</button>
        </div>
      `;
      step2.querySelector<HTMLButtonElement>('.step2-thanks-close')
        ?.addEventListener('click', () => closeFullscreen(step2));
    }

    lockMaxHeight();
  }
</script>

<style is:global>
  .step2-checkmark {
    transform-origin: center;
    animation: step2-checkmark-pop 360ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .step2-check-circle {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: step2-draw 420ms ease-out 80ms forwards;
  }
  .step2-check-tick {
    stroke-dasharray: 50;
    stroke-dashoffset: 50;
    animation: step2-draw 240ms ease-out 380ms forwards;
  }
  .step2-thanks-msg,
  .step2-thanks-sub,
  .step2-thanks-close {
    opacity: 0;
    transform: translateY(8px);
    animation: step2-fade-up 360ms ease-out forwards;
  }
  .step2-thanks-msg { animation-delay: 600ms; }
  .step2-thanks-sub { animation-delay: 780ms; }
  .step2-thanks-close { animation-delay: 1000ms; }

  @keyframes step2-checkmark-pop {
    from { transform: scale(0.4); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
  }
  @keyframes step2-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes step2-fade-up {
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .step2-checkmark,
    .step2-check-circle,
    .step2-check-tick,
    .step2-thanks-msg,
    .step2-thanks-sub,
    .step2-thanks-close {
