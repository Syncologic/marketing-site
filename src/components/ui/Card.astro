---
type Radius = 'card' | 'feature';
type Elevation = 'flat' | 'elevated';

interface Props {
  radius?: Radius;
  elevation?: Elevation;
  class?: string;
  as?: 'div' | 'article' | 'section';
}

const { radius = 'card', elevation = 'flat', class: extra = '', as = 'div' } = Astro.props as Props;

const radii: Record<Radius, string> = {
  card: 'rounded-card',
  feature: 'rounded-feature',
};

const squircleRadius = radius === 'feature' ? 32 : 24;
const wrapClass = elevation === 'elevated' ? 'squircle-elevation card-elevated-halo' : 'squircle-elevation';

const classes = ['glass-pane', radii[radius], extra].filter(Boolean).join(' ');
const Tag = as;
---

<div class={wrapClass}>
  <Tag class={classes} data-squircle data-squircle-radius={squircleRadius}><slot /></Tag>
</div>

<style is:global>
  .card-elevated-halo {
    filter:
      var(--drop-shadow-sky-md)
      drop-shadow(0 12px 36px color-mix(in srgb, var(--sky-action) 30%, transparent));
  }
</style>
