---
import { getLocaleFromUrl, getT } from '../../i18n/utils';

interface Props {
  label?: string;
  class?: string;
}

const { label, class: extra = '' } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = getT(locale);
const resolvedLabel = label ?? t('guides.callout.note');
---

<aside class={`bg-[color:color-mix(in_srgb,var(--sky-action)_12%,transparent)] rounded-card px-6 py-5 my-8 text-body text-ink ${extra}`}>
  <span class="block text-caption font-medium uppercase tracking-wide text-ink-soft mb-2">{resolvedLabel}</span>
  <div class="prose-syncologic-note">
    <slot />
  </div>
</aside>

<style>
  .prose-syncologic-note :global(p) {
    margin: 0;
  }
  .prose-syncologic-note :global(p + p) {
    margin-top: 0.75rem;
  }
</style>
